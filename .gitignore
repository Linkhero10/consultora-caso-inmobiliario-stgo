# Secretos
.env
*.env
.env.*

# Infraestructura interna de proceso (bitacora, seguimiento de etapas)
_FARO/
FARO.md

# Cache de Python / pytest / metadata de instalacion editable
__pycache__/
*.pyc
.pytest_cache/
**/.pytest_cache/
*.egg-info/

# Workspace de desarrollo local (versiones intermedias, auditorias, correcciones puntuales).
# La release publica vive en src/config/tests/data/docs/products/audit; ver README.md.
Trabajo/
Auditoria/
Productos/

# Dataset externo CASEN (publico, pesado, no es corpus propio del proyecto)
Fuentes/fuentes_externas/raw/F-03/

# Texto completo y PDFs de fuentes de terceros -- ver DATA_NOTICE.md.
# Solo se versiona metadata (url, fuente, fecha, hash, lineage), no la copia completa del contenido.
Fuentes/fulltext_v1/
Fuentes/fulltext_v2/content/
Fuentes/literatura/pdf/

# Artefactos de respaldo/temporales (recuperacion de crashes, no son datos)
*.pre_backfill_backup
*.tmp.*

# Test huerfano: su archivo objetivo (herramienta de revision interna) no es parte de la release
tests/test_blind_review_html.py

# Planes de implementacion internos, no forman parte del producto
docs/superpowers/
