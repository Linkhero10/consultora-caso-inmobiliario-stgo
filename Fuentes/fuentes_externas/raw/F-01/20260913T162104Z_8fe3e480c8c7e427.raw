_1069":{"uri":"widgets/common/button/","version":"1.19.0","label":"Botón 12","config":{"functionConfig":{"text":"Manual de usuario","toolTip":"","textExpression":null,"icon":{"data":{"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 16 16\"><path fill=\"#000\" fill-rule=\"evenodd\" d=\"M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 9a4 4 0 1 0-2.214-.668A7.5 7.5 0 0 0 .5 15.5h1A6.5 6.5 0 0 1 8 9m0 2h7v1H8zm7 3H8v1h7z\" clip-rule=\"evenodd\"></path></svg>","properties":{"filename":"PersonMenuOutlined","originalName":"outlined/application/person-menu.svg","path":["application","PersonMenuOutlined"],"inlineSvg":true,"isUploaded":false,"color":"var(--ref-palette-neutral-1100)"}},"position":"LEFT"},"linkParam":{"linkType":"WEB_ADDRESS","openType":"_blank","value":"https://ine-chile.maps.arcgis.com/sharing/rest/content/items/6c5038442bf348d5af67cb77dd91be7e/data","expression":null}},"styleConfig":{"themeStyle":{"quickStyleType":"primary"},"useCustom":true,"customStyle":{"hover":{"enableDynamicStyle":false},"regular":{"enableDynamicStyle":false,"borderRadius":{"number":[50,50,50,50],"unit":"px"}}}}},"id":"widget_1069","useDataSourcesEnabled":false,"useDataSources":[]},"widget_1072":{"uri":"widgets/common/text/","version":"1.19.0","label":"Texto 179","config":{"text":"<p style=\"text-align: right;\"><strong style=\"color: var(--light);\">Principales&nbsp;resultados Región - Comuna </strong></p>","style":{"wrap":true},"tooltip":{"name":"","parts":[{"type":"STRING","exp":"\"\""}]}},"id":"widget_1072"},"widget_1074":{"uri":"widgets/common/button/","version":"1.19.0","label":"Botón 13","config":{"functionConfig":{"text":"Ir a Dashboard geografico","textExpression":null,"linkParam":{"linkType":"WEB_ADDRESS","openType":"_blank","value":"https://ine-chile.maps.arcgis.com/apps/dashboards/f0267063ad184de1a8b5ef6e2ef3b3da","expression":null}},"styleConfig":{"themeStyle":{"quickStyleType":"primary"},"useCustom":true,"customStyle":{"hover":{"enableDynamicStyle":false,"background":{"color":"#2053a3","fillType":"fill"},"borderRadius":{"number":[15,15,15,15],"unit":"px"}},"regular":{"enableDynamicStyle":false,"background":{"color":"#ed008c","fillType":"fit"},"border":{"width":null},"borderRadius":{"number":[15,15,15,15],"unit":"px"}}}}},"id":"widget_1074","useDataSources":[]},"widget_1077":{"uri":"widgets/layout/column/","version":"1.19.0","label":"Columna 11","config":{"space":{"distance":2,"unit":"px"},"style":{"padding":{"space":[10],"unit":"px"},"justifyContent":"space-around","alignItems":"stretch"}},"id":"widget_1077","layouts":{"DEFAULT":{"LARGE":"layout_941"}}},"widget_1079":{"uri":"widgets/layout/column/","version":"1.19.0","label":"Columna 13","config":{"space":{"distance":0,"unit":"px"},"style":{"padding":{"space":[10],"unit":"px"},"justifyContent":"flex-start","alignItems":"stretch"}},"id":"widget_1079","layouts":{"DEFAULT":{"LARGE":"layout_943"}}},"widget_1080":{"uri":"widgets/common/text/","version":"1.19.0","label":"Texto 180","config":{"text":"<p><br></p><p style=\"text-align: center;\"><strong style=\"font-size: 16px; color: rgb(29, 51, 107);\">Notas</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Nota técnica 1 - Variables disponibles</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">El visualizador incluye 53 indicadores del Censo 2024 sobre población, hogares y viviendas. De manera progresiva se incorporarán nuevos indicadores y capas geográficas, según evaluaciones técnicas y criterios de confidencialidad.</span></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">Para acceder a un mayor conjunto de variables, es posible descargar la cartografía censal y las bases asociadas desde la página de resultados del Censo 2024.</span></p><p style=\"text-align: justify;\"><br></p><p><strong style=\"font-size: inherit; color: rgb(29, 51, 107);\">Nota técnica 2 – Valores 0%</strong></p><p><br></p><p style=\"text-align: justify;\"><span style=\"font-size: inherit; color: rgb(29, 51, 107);\">Un valor de 0% puede indicar ausencia del atributo analizado en la unidad territorial o la aplicación de criterios de anonimización estadística, conforme a la normativa vigente.</span></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Nota técnica 3 - Contenedores comunales</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">No todos los registros censales de la base de datos se encuentran asociados a manzanas o entidades, ya que por sus características específicas al momento del levantamiento no se llegó a niveles de desagregación mayor que la comuna. Estos casos corresponden a los datos recolectados en el marco de operativos especiales y personas en situación de calle.</span></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Sobre el visualizador</strong></p><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\" style=\"text-align: justify;\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">La disposición de la información en pantalla puede variar según el tamaño y la resolución del dispositivo. Se recomienda disminuir el zoom del navegador para una mejor experiencia. </span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\" style=\"text-align: justify;\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">Se recomienda utilizar los navegadores Google Chrome o Microsoft Edge, Mozilla Firefox y Safari. </span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\" style=\"text-align: justify;\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">Los separadores de miles en las cifras pueden visualizarse como “.” o “,”, dependiendo de la configuración regional del equipo del usuario. </span><span style=\"background-color: white; font-family: &quot;Avenir Next&quot;; font-size: 13px; color: rgb(29, 51, 107);\">﻿</span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\" style=\"text-align: justify;\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"font-family: &quot;Avenir Next&quot;; font-size: 13px; color: rgb(29, 51, 107);\">Descarga el manual de uso del Visualizador geográfico accediendo al botón \"Manual de usuario\"</span></li></ol>","style":{"wrap":true}},"id":"widget_1080","style":{"background":{"color":"#ffffff","fillType":"fill","image":{"url":""}},"textColor":"#1a1c1c"}},"widget_1081":{"uri":"widgets/layout/column/","version":"1.19.0","label":"Columna 14","config":{"space":{"distance":0,"unit":"px"},"style":{"padding":{"space":[10],"unit":"px"},"justifyContent":"flex-start","alignItems":"stretch"}},"id":"widget_1081","layouts":{"DEFAULT":{"LARGE":"layout_944"}}},"widget_1082":{"uri":"widgets/common/text/","version":"1.19.0","label":"Texto 181","config":{"text":"<p><br></p><p style=\"text-align: center;\"><strong style=\"font-size: 16px; color: rgb(29, 51, 107);\">Notas</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Nota técnica 1 - Variables disponibles</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">El visualizador incluye 53 indicadores del Censo 2024 sobre población, hogares y viviendas. De manera progresiva se incorporarán nuevos indicadores y capas geográficas, según evaluaciones técnicas y criterios de confidencialidad.</span></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">Para acceder a un mayor conjunto de variables, es posible descargar la cartografía censal y las bases asociadas desde la página de resultados del Censo 2024.</span></p><p style=\"text-align: justify;\"><br></p><p><strong style=\"font-size: inherit; color: rgb(29, 51, 107);\">Nota técnica 2 – Valores 0%</strong></p><p><br></p><p style=\"text-align: justify;\"><span style=\"font-size: inherit; color: rgb(29, 51, 107);\">Un valor de 0% puede indicar ausencia del atributo analizado en la unidad territorial o la aplicación de criterios de anonimización estadística, conforme a la normativa vigente.</span></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Nota técnica 3 - Contenedores comunales</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">No todos los registros censales de la base de datos se encuentran asociados a manzanas o entidades, ya que por sus características específicas al momento del levantamiento no se llegó a niveles de desagregación mayor que la comuna. Estos casos corresponden a los datos recolectados en el marco de operativos especiales y personas en situación de calle.</span></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Sobre el visualizador</strong></p><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">La disposición de la información en pantalla puede variar según el tamaño y la resolución del dispositivo. Se recomienda disminuir el zoom del navegador para una mejor experiencia. </span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">Se recomienda utilizar los navegadores Google Chrome o Microsoft Edge, Mozilla Firefox y Safari. </span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">Los separadores de miles en las cifras pueden visualizarse como “.” o “,”, dependiendo de la configuración regional del equipo del usuario. </span><span style=\"color: rgb(29, 51, 107); background-color: white; font-family: &quot;Avenir Next&quot;; font-size: 13px;\">﻿</span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"font-family: &quot;Avenir Next&quot;; font-size: 13px; color: rgb(29, 51, 107);\">Descarga el manual de uso del Visualizador geográfico accediendo al botón \"Manual de usuario\"</span></li></ol>","style":{"wrap":true}},"id":"widget_1082"},"widget_1083":{"uri":"widgets/common/button/","version":"1.19.0","label":"Botón 14","config":{"functionConfig":{"text":"Manual de usuario","textExpression":null,"icon":{"data":{"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 16 16\"><path fill=\"#000\" fill-rule=\"evenodd\" d=\"M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 9a4 4 0 1 0-2.214-.668A7.5 7.5 0 0 0 .5 15.5h1A6.5 6.5 0 0 1 8 9m0 2h7v1H8zm7 3H8v1h7z\" clip-rule=\"evenodd\"></path></svg>","properties":{"filename":"PersonMenuOutlined","originalName":"outlined/application/person-menu.svg","path":["application","PersonMenuOutlined"],"inlineSvg":true,"isUploaded":false,"color":"var(--ref-palette-neutral-1100)"}},"position":"LEFT"},"linkParam":{"linkType":"WEB_ADDRESS","openType":"_blank","value":"https://ine-chile.maps.arcgis.com/sharing/rest/content/items/6c5038442bf348d5af67cb77dd91be7e/data","expression":null}},"styleConfig":{"themeStyle":{"quickStyleType":"primary"},"useCustom":true,"customStyle":{"hover":{"enableDynamicStyle":false},"regular":{"enableDynamicStyle":false,"borderRadius":{"number":[50,50,50,50],"unit":"px"}}}}},"id":"widget_1083","useDataSources":[]},"widget_1084":{"uri":"widgets/layout/column/","version":"1.19.0","label":"Columna 15","config":{"space":{"distance":0,"unit":"px"},"style":{"padding":{"space":[10],"unit":"px"},"justifyContent":"flex-start","alignItems":"stretch"}},"id":"widget_1084","layouts":{"DEFAULT":{"LARGE":"layout_945"}}},"widget_1085":{"uri":"widgets/common/text/","version":"1.19.0","label":"Texto 182","config":{"text":"<p><br></p><p style=\"text-align: center;\"><strong style=\"font-size: 16px; color: rgb(29, 51, 107);\">Notas</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Nota técnica 1 - Variables disponibles</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">El visualizador incluye 53 indicadores del Censo 2024 sobre población, hogares y viviendas. De manera progresiva se incorporarán nuevos indicadores y capas geográficas, según evaluaciones técnicas y criterios de confidencialidad.</span></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">Para acceder a un mayor conjunto de variables, es posible descargar la cartografía censal y las bases asociadas desde la página de resultados del Censo 2024.</span></p><p style=\"text-align: justify;\"><br></p><p><strong style=\"font-size: inherit; color: rgb(29, 51, 107);\">Nota técnica 2 – Valores 0%</strong></p><p><br></p><p style=\"text-align: justify;\"><span style=\"font-size: inherit; color: rgb(29, 51, 107);\">Un valor de 0% puede indicar ausencia del atributo analizado en la unidad territorial o la aplicación de criterios de anonimización estadística, conforme a la normativa vigente.</span></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Nota técnica 3 - Contenedores comunales</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">No todos los registros censales de la base de datos se encuentran asociados a manzanas o entidades, ya que por sus características específicas al momento del levantamiento no se llegó a niveles de desagregación mayor que la comuna. Estos casos corresponden a los datos recolectados en el marco de operativos especiales y personas en situación de calle.</span></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Sobre el visualizador</strong></p><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">La disposición de la información en pantalla puede variar según el tamaño y la resolución del dispositivo. Se recomienda disminuir el zoom del navegador para una mejor experiencia. </span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">Se recomienda utilizar los navegadores Google Chrome o Microsoft Edge, Mozilla Firefox y Safari. </span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">Los separadores de miles en las cifras pueden visualizarse como “.” o “,”, dependiendo de la configuración regional del equipo del usuario. </span><span style=\"color: rgb(29, 51, 107); background-color: white; font-family: &quot;Avenir Next&quot;; font-size: 13px;\">﻿</span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"font-family: &quot;Avenir Next&quot;; font-size: 13px; color: rgb(29, 51, 107);\">Descarga el manual de uso del Visualizador geográfico accediendo al botón \"Manual de usuario\"</span></li></ol>","style":{"wrap":true}},"id":"widget_1085","useDataSourcesEnabled":false},"widget_1086":{"uri":"widgets/common/button/","version":"1.19.0","label":"Botón 15","config":{"functionConfig":{"text":"Manual de usuario","textExpression":null,"icon":{"data":{"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 16 16\"><path fill=\"#000\" fill-rule=\"evenodd\" d=\"M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 9a4 4 0 1 0-2.214-.668A7.5 7.5 0 0 0 .5 15.5h1A6.5 6.5 0 0 1 8 9m0 2h7v1H8zm7 3H8v1h7z\" clip-rule=\"evenodd\"></path></svg>","properties":{"filename":"PersonMenuOutlined","originalName":"outlined/application/person-menu.svg","path":["application","PersonMenuOutlined"],"inlineSvg":true,"isUploaded":false,"color":"var(--ref-palette-neutral-1100)"}},"position":"LEFT"},"linkParam":{"linkType":"WEB_ADDRESS","openType":"_blank","value":"https://ine-chile.maps.arcgis.com/sharing/rest/content/items/6c5038442bf348d5af67cb77dd91be7e/data","expression":null}},"styleConfig":{"themeStyle":{"quickStyleType":"primary"},"useCustom":true,"customStyle":{"hover":{"enableDynamicStyle":false},"regular":{"enableDynamicStyle":false,"borderRadius":{"number":[50,50,50,50],"unit":"px"}}}}},"id":"widget_1086","useDataSources":[]},"widget_1087":{"uri":"widgets/layout/column/","version":"1.19.0","label":"Columna 16","config":{"space":{"distance":0,"unit":"px"},"style":{"padding":{"space":[10],"unit":"px"},"justifyContent":"flex-start","alignItems":"stretch"}},"id":"widget_1087","layouts":{"DEFAULT":{"LARGE":"layout_946"}}},"widget_1088":{"uri":"widgets/common/text/","version":"1.19.0","label":"Texto 183","config":{"text":"<p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><strong style=\"color: rgb(29, 51, 107); font-size: 16px;\"><span class=\"ql-cursor\">﻿</span>Notas</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Nota técnica 1 - Variables disponibles</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">El visualizador incluye 53 indicadores del Censo 2024 sobre población, hogares y viviendas. De manera progresiva se incorporarán nuevos indicadores y capas geográficas, según evaluaciones técnicas y criterios de confidencialidad.</span></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">Para acceder a un mayor conjunto de variables, es posible descargar la cartografía censal y las bases asociadas desde la página de resultados del Censo 2024.</span></p><p style=\"text-align: justify;\"><br></p><p><strong style=\"color: rgb(29, 51, 107); font-size: inherit;\">Nota técnica 2 – Valores 0%</strong></p><p><br></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107); font-size: inherit;\">Un valor de 0% puede indicar ausencia del atributo analizado en la unidad territorial o la aplicación de criterios de anonimización estadística, conforme a la normativa vigente.</span></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Nota técnica 3 - Contenedores comunales</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">No todos los registros censales de la base de datos se encuentran asociados a manzanas o entidades, ya que por sus características específicas al momento del levantamiento no se llegó a niveles de desagregación mayor que la comuna. Estos casos corresponden a los datos recolectados en el marco de operativos especiales y personas en situación de calle.</span></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Sobre el visualizador</strong></p><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">La disposición de la información en pantalla puede variar según el tamaño y la resolución del dispositivo. Se recomienda disminuir el zoom del navegador para una mejor experiencia. </span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">Se recomienda utilizar los navegadores Google Chrome o Microsoft Edge, Mozilla Firefox y Safari. </span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">Los separadores de miles en las cifras pueden visualizarse como “.” o “,”, dependiendo de la configuración regional del equipo del usuario. </span><span style=\"color: rgb(29, 51, 107); font-size: 13px; font-family: &quot;Avenir Next&quot;; background-color: white;\">﻿</span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107); font-size: 13px; font-family: &quot;Avenir Next&quot;;\">Descarga el manual de uso del Visualizador geográfico accediendo al botón \"Manual de usuario\"</span></li></ol>","style":{"wrap":true}},"id":"widget_1088"},"widget_1089":{"uri":"widgets/common/button/","version":"1.19.0","label":"Botón 16","config":{"functionConfig":{"text":"Manual de usuario","textExpression":null,"icon":{"data":{"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 16 16\"><path fill=\"#000\" fill-rule=\"evenodd\" d=\"M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 9a4 4 0 1 0-2.214-.668A7.5 7.5 0 0 0 .5 15.5h1A6.5 6.5 0 0 1 8 9m0 2h7v1H8zm7 3H8v1h7z\" clip-rule=\"evenodd\"></path></svg>","properties":{"filename":"PersonMenuOutlined","originalName":"outlined/application/person-menu.svg","path":["application","PersonMenuOutlined"],"inlineSvg":true,"isUploaded":false,"color":"var(--ref-palette-neutral-1100)"}},"position":"LEFT"},"linkParam":{"linkType":"WEB_ADDRESS","openType":"_blank","value":"https://ine-chile.maps.arcgis.com/sharing/rest/content/items/6c5038442bf348d5af67cb77dd91be7e/data","expression":null}},"styleConfig":{"themeStyle":{"quickStyleType":"primary"},"useCustom":true,"customStyle":{"hover":{"enableDynamicStyle":false},"regular":{"enableDynamicStyle":false,"borderRadius":{"number":[50,50,50,50],"unit":"px"}}}}},"id":"widget_1089","useDataSources":[]},"widget_1090":{"uri":"widgets/layout/column/","version":"1.19.0","label":"Columna 17","config":{"space":{"distance":0,"unit":"px"},"style":{"padding":{"space":[10],"unit":"px"},"justifyContent":"flex-start","alignItems":"stretch"}},"id":"widget_1090","layouts":{"DEFAULT":{"LARGE":"layout_947"}}},"widget_1091":{"uri":"widgets/common/text/","version":"1.19.0","label":"Texto 184","config":{"text":"<p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><strong style=\"font-size: 16px; color: rgb(29, 51, 107);\">Notas</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Nota técnica 1 - Variables disponibles</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">El visualizador incluye 53 indicadores del Censo 2024 sobre población, hogares y viviendas. De manera progresiva se incorporarán nuevos indicadores y capas geográficas, según evaluaciones técnicas y criterios de confidencialidad.</span></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">Para acceder a un mayor conjunto de variables, es posible descargar la cartografía censal y las bases asociadas desde la página de resultados del Censo 2024.</span></p><p style=\"text-align: justify;\"><br></p><p><strong style=\"font-size: inherit; color: rgb(29, 51, 107);\">Nota técnica 2 – Valores 0%</strong></p><p><br></p><p style=\"text-align: justify;\"><span style=\"font-size: inherit; color: rgb(29, 51, 107);\">Un valor de 0% puede indicar ausencia del atributo analizado en la unidad territorial o la aplicación de criterios de anonimización estadística, conforme a la normativa vigente.</span></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Nota técnica 3 - Contenedores comunales</strong></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">No todos los registros censales de la base de datos se encuentran asociados a manzanas o entidades, ya que por sus características específicas al momento del levantamiento no se llegó a niveles de desagregación mayor que la comuna. Estos casos corresponden a los datos recolectados en el marco de operativos especiales y personas en situación de calle.</span></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><strong style=\"color: rgb(29, 51, 107);\">Sobre el visualizador</strong></p><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">La disposición de la información en pantalla puede variar según el tamaño y la resolución del dispositivo. Se recomienda disminuir el zoom del navegador para una mejor experiencia. </span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">Se recomienda utilizar los navegadores Google Chrome o Microsoft Edge, Mozilla Firefox y Safari. </span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"color: rgb(29, 51, 107);\">Los separadores de miles en las cifras pueden visualizarse como “.” o “,”, dependiendo de la configuración regional del equipo del usuario. </span><span style=\"color: rgb(29, 51, 107); background-color: white; font-family: &quot;Avenir Next&quot;; font-size: 13px;\">﻿</span></li></ol><p style=\"text-align: justify;\"><br></p><ol><li data-list=\"bullet\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"font-family: &quot;Avenir Next&quot;; font-size: 13px; color: rgb(29, 51, 107);\">Descarga el manual de uso del Visualizador geográfico accediendo al botón \"Manual de usuario\"</span></li></ol>","style":{"wrap":true}},"id":"widget_1091"},"widget_1092":{"uri":"widgets/common/button/","version":"1.19.0","label":"Botón 17","config":{"functionConfig":{"text":"Manual de usuario","textExpression":null,"icon":{"data":{"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 16 16\"><path fill=\"#000\" fill-rule=\"evenodd\" d=\"M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 9a4 4 0 1 0-2.214-.668A7.5 7.5 0 0 0 .5 15.5h1A6.5 6.5 0 0 1 8 9m0 2h7v1H8zm7 3H8v1h7z\" clip-rule=\"evenodd\"></path></svg>","properties":{"filename":"PersonMenuOutlined","originalName":"outlined/application/person-menu.svg","path":["application","PersonMenuOutlined"],"inlineSvg":true,"isUploaded":false,"color":"var(--ref-palette-neutral-1100)"}},"position":"LEFT"},"linkParam":{"linkType":"WEB_ADDRESS","openType":"_blank","value":"https://ine-chile.maps.arcgis.com/sharing/rest/content/items/6c5038442bf348d5af67cb77dd91be7e/data","expression":null}},"styleConfig":{"themeStyle":{"quickStyleType":"primary"},"useCustom":true,"customStyle":{"hover":{"enableDynamicStyle":false},"regular":{"enableDynamicStyle":false,"borderRadius":{"number":[50,50,50,50],"unit":"px"}}}}},"id":"widget_1092","useDataSources":[]},"widget_1093":{"uri":"widgets/common/print/","version":"1.19.0","label":"Imprimir","config":{"printServiceType":"CUSTOMIZ