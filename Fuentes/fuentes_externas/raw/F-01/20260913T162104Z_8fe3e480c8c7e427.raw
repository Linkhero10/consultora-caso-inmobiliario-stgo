lineStyle":{"type":"solid","color":"var(--light-500)","width":"1px"}},"resizable":true,"toggleBtn":{"visible":true,"iconSource":0,"icon":"DOWN","offsetX":0,"offsetY":-22,"position":"CENTER","iconSize":20,"width":80,"height":22,"border":{"type":"solid","color":"var(--light-500)","width":"1px"},"color":{"normal":{"icon":{"useTheme":false,"color":"var(--light)"},"bg":{"useTheme":false,"color":"var(--primary)"}},"hover":{"bg":{"useTheme":false,"color":"var(--primary-700)"}}},"expandStyle":{"style":{"borderRadius":"92px 92px 0 0"}},"collapseStyle":{"style":{"borderRadius":"92px 92px 0 0"}}},"defaultState":0},"id":"widget_29","layouts":{"FIRST":{"SMALL":"layout_48"},"SECOND":{"SMALL":"layout_51"}},"label":"Barra lateral 6"},"widget_30":{"uri":"widgets/common/navigator/","version":"1.19.0","config":{"data":{"type":"AUTO","section":"section_1","views":[]},"display":{"advanced":true,"vertical":false,"type":"nav","navStyle":"default","standard":{"scrollable":true,"textAlign":"center","gap":"0px","showText":false,"showIcon":true,"iconPosition":"start"},"variant":{"root":{"bg":"var(--primary-600)"},"item":{"default":{"icon":{"color":"var(--light)","size":"16px"}},"active":{"icon":{"size":"16px","color":"var(--light)"},"bg":"var(--primary-500)"},"hover":{"icon":{"size":"16px","color":"var(--primary-200)"}}}}}},"id":"widget_30","label":"Navegación por vistas 3"},"widget_31":{"uri":"widgets/layout/flowrow/","version":"1.19.0","config":{"space":10,"style":{"padding":{"space":[10],"unit":"px"},"justifyContent":"flex-start","alignItems":"stretch"}},"id":"widget_31","layouts":{"DEFAULT":{"LARGE":"layout_52"}},"label":"Encabezado","style":{"background":{"color":"#1d336b","fillType":"fill","image":{"url":""}},"textColor":"#ffffff"}},"widget_32":{"uri":"widgets/common/text/","version":"1.19.0","config":{"text":"<p style=\"text-align: center;\"><strong style=\"color: rgb(29, 51, 107); font-size: 20px;\">Visualizador Geográfico Manzana-Entidad</strong></p><p style=\"text-align: center;\"><strong style=\"color: rgb(29, 51, 107); font-size: 18px;\">Censo de Población y Vivienda 2024&nbsp;</strong></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107); display: block;\"><img src=\"https://www.arcgis.com/sharing/rest/content/items/19d458e8ff1f47d9a081eef6f72425c5/resources/images/widget_43/1752068149443.png\" alt=\"\" data-name=\"1752068149443.png\" width=\"286\" style=\"width: 65%; display: block; margin: 0.9em auto;\"></span></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">En esta sección se presentan los principales indicadores de resultados del Censo de Población y Vivienda 2024, desagregados a nivel geográfico, con el objetivo de facilitar el análisis territorial y la visualización de la información. La herramienta permite explorar la información del Censo 2024 a nivel de manzana y entidad censal, con un mayor nivel de detalle territorial y de caracterización de la población, viviendas y hogares.</span></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">Los datos se encuentran georreferenciados en el sistema de referencia espacial SIRGAS 2000, proyección UTM huso 19 Sur (EPSG: 31979), y abarcan la totalidad del territorio nacional. </span></p><p style=\"text-align: justify;\"><br></p><p style=\"text-align: justify;\"><span style=\"color: rgb(29, 51, 107);\">﻿Los límites y fronteras de Chile utilizados en este geoportal son de carácter referencial y no comprometen al Estado de Chile, conforme a lo dispuesto en el artículo 2°, letra g), del DFL N°83 de 1979 del Ministerio de Relaciones Exteriores. La representación del Límite Internacional ha sido autorizada para una escala 1:50.000; cualquier representación a escalas mayores puede no corresponder completamente al trazado de los límites oficiales. Los límites comunales utilizados en este geoportal fueron elaborados con fines censales, con el objetivo de garantizar la correcta ejecución del Censo de Población y Vivienda. Su uso no constituye un pronunciamiento sobre delimitaciones oficiales, ya que estas definiciones responden exclusivamente a necesidades operativas y estadísticas.</span></p>"},"id":"widget_32","label":"Texto - Hi"},"widget_35":{"uri":"widgets/common/image/","version":"1.19.0","config":{"functionConfig":{"altText":"","toolTip":"","linkParam":{"linkType":"WEB_ADDRESS","openType":"_blank","value":"https://censo2024.ine.gob.cl/","expression":null},"scale":"Fit","imageParam":{"url":"${appResourceUrl}/images/widget_35/1769291407472.png","originalUrl":"${appResourceUrl}/images/widget_35/1769291407472.png","fileName":"1769291407472.png","originalName":"CENSO 2024_BLANCO Y COLOR.png","imgSourceType":"BY_UPLOAD","fileFormat":"image/png","originalId":"1769291407472","originalWidth":4928,"originalHeight":2582},"imageDisplayQualityMode":"ORIGINAL","imgSourceType":"","srcExpression":null,"imageFillMode":"FIT"},"styleConfig":{}},"id":"widget_35","label":"Logo Censo","useDataSources":[]},"widget_37":{"uri":"widgets/common/image/","version":"1.19.0","label":"Imagen_Censo_Hi","config":{"functionConfig":{"altText":"","toolTip":"","linkParam":{"linkType":"WEB_ADDRESS","openType":"_blank","value":"https://censo2024.ine.gob.cl/","expression":null},"scale":"Fit","imageParam":{"url":"${appResourceUrl}/images/widget_37/1754577560825.png","originalUrl":"${appResourceUrl}/images/widget_37/1754577560825.png","fileName":"1754577560825.png","originalName":"CENSO 2024_COLOR.png","imgSourceType":"BY_UPLOAD","fileFormat":"image/png","originalId":"1754577560825","originalWidth":4928,"originalHeight":2582},"imageDisplayQualityMode":"ORIGINAL","imgSourceType":"","srcExpression":null},"styleConfig":{}},"id":"widget_37","useDataSources":[]},"widget_39":{"uri":"widgets/common/menu/","version":"1.19.0","label":"Menú -  Totalizadores","config":{"type":"nav","vertical":false,"advanced":true,"variant":{"item":{"default":{"bold":true,"bg":"#ed008c","color":"#ffffff","bor