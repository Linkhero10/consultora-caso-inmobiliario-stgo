ena","format":{"digitSeparator":true}},{"jimuName":"n_tipo_viv_pieza","name":"n_tipo_viv_pieza","type":"NUMBER","esriType":"esriFieldTypeInteger","alias":"Viviendas con tipo de vivienda: pieza en casa antigua o conventillo","format":{"digitSeparator":true}},{"jimuName":"n_tipo_viv_mediagua","name":"n_tipo_viv_mediagua","type":"NUMBER","esriType":"esriFieldTypeInteger","alias":"Viviendas con tipo de vivienda: mediagua, mejora, etc","format":{"digitSeparator":true}},{"jimuName":"n_tipo_viv_movil","name":"n_tipo_viv_movil","type":"NUMBER","esriType":"esriFieldTypeInteger","alias":"Viviendas con tipo de vivienda: móvil","format":{"digitSeparator":true}},{"jimuName":"n_tipo_viv_otro","name":"n_tipo_viv_otro","type":"NUMBER","esriType":"esriFieldTypeInteger","alias":"Viviendas con tipo de vivienda: otro tipo de vivienda","format":{"digitSeparator":true}},{"jimuName":"n_dormitorios_1","name":"n_dormitorios_1","type":"NUMBER","esriType":"esriFieldTypeInteger","alias":"Número de viviendas con 1 dormitorio","format":{"digitSeparator":true}},{"jimuName":"n_dormitorios_2","name":"n_dormitorios_2","type":"NUMBER","esriType":"esriFieldTypeInteger","alias":"Número de viviendas con 2 dormitorios","format":{"digitSeparator":true}},{"jimuName":"n_dormitorios_3","name":"n_dormitorios_3","type":"NUMBER","esriType":"esriFieldTypeInteger","alias":"Número de viviendas con 3 dormitorios","format":{"digitSeparator":true}},{"jimuName":"n_dormitorios_4","name":"n_dormitorios_4","type":"NUMBER","esriType":"esriFieldTypeInteger","alias":"Número de viviendas con 4 dormitorios","format":{"digitSeparator":true}},{"jimuName":"n_dormitorios_5","name":"n_dormitorios_5","type":"NUMBER","esriType":"esriFieldTypeInteger","alias":"Número de viviendas con 5 dormitorios","format":{"digitSeparator":true}},{"jimuName":"n_dormitorios_6_o_mas","name":"n_dormitorios_6_o_mas","type":"NUMBER","esriType":"esriFieldTypeInteger","alias":"Número de viviendas con 6 dormitorios o más","format":{"digitSeparator":true}},