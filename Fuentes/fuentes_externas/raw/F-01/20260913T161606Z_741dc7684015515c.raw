<!-- Main content: shift it to the right by 270 pixels when the sidebar is visible -->
<div class="w3-main" style="margin-left:310px; margin-top:10px; height: 100%;" id="myMain" >

	<div class="w3-blue" style="background: #1D336B !important;">
