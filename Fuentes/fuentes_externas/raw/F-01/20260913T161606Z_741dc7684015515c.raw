<script>
function w3_open()
{
	document.getElementById("mySidebar").style.display = "block";
	document.getElementById("myOverlay").style.display = "block";
}
function w3_close() 
{
	document.getElementById("mySidebar").style.display = "none";
	document.getElementById("myOverlay").style.display = "none";
}

</script>
<style>
/* SOLUCIÓN NUCLEAR - ELIMINAR SCROLL HORIZONTAL COMPLETAMENTE */
@media (max-width: 768px) {
    /* Bloquear scroll horizontal a nivel de raíz */
    html, body {
        overflow-x: hidden !important;
        width: 100% !important;
        max-width: 100vw !important;
        position: relative !important;
        margin: 0 !important;
        padding: 0 !important;
    }
    
    /* Forzar a todos los elementos a no exceder el ancho */
    body * {
        max-width: 100% !important;
        box-sizing: border-box !important;
        overflow-x: hidden !important;
    }
    
    /* Contenedores principales */
    .w3-main, 
    #myMain {
        margin-left: 0 !important;
        margin-right: 0 !important;
        width: 100vw !important;
        max-width: 100vw !important;
        overflow-x: hidden !important;
    }
    
    /* El menú puede tener scroll interno PERO no afectar el body */
    #divMenu {
        width: 100% !important;
        max-width: 100vw !important;
        overflow: visible !important;
    }
    
    #root {
        width: 100% !important;
        overflow-x: auto !important;
        overflow-y: hidden !important;
    }
    
    /* Botón visible */
    .w3-button.w3-xlarge.w3-hide-large {
        display: inline-block !important;
    }
    
    #Cont-central,
    iframe[name="Output"] {
        width: 100% !important;
        max-width: 100% !important;
    }
    
    /* Bloquear cualquier posibilidad de scroll horizontal */
    .w3-main *,
    #myMain *,
    #Cont-central * {
        overflow-x: hidden !important;
        max-width: 100% !important;
    }
}
</style>
