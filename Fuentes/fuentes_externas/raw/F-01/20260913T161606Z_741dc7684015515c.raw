<script>
   // EN LA PÁGINA PRINCIPAL - Responder a solicitudes
	window.addEventListener('message', function(event) {
		console.log('📨 Main recibió mensaje:', event.data);
		
		if (event.data.type === 'solicitarTitulo') {
			console.log('🔁 Enviando título al iframe...');
			
			// Obtener el título del header
			const headerIframe = document.getElementsByName('Header')[0];
			const titulo = headerIframe.contentDocument.getElementById('titulo').textContent.trim();
			
			// Enviar al iframe que solicitó
			event.source.postMessage({
				type: 'tituloHeader',
				value: titulo
			}, event.origin);
			
			console.log('✅ Título enviado:', titulo);
		}
	});
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const iframe = document.querySelector('iframe[name="Output"]');
    if (iframe) {
      iframe.style.height = '1200px';
    }
  });
</script>

<body >

<!-- Top -->
<header class="w3-top">
		<iframe name="Header" src="https://redatam.ine.gob.cl/redbin/RpWebUtilities.exe/Text?LFN=RpBases\Tempo\55466\~tmp_554661.htm&amp;TYPE=TMP" scrolling="no" style="height: 10px;" ></iframe>
