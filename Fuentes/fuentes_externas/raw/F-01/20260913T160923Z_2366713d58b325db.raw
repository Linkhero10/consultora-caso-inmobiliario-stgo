    <script>
        function mostrarContenido() {
            // Ocultar todas las secciones
            const secciones = document.querySelectorAll('.content-section');
            secciones.forEach((seccion) => {
                seccion.classList.remove('active');
            });

            // Obtener la opción seleccionada
            const opcion = document.getElementById("menu").value;
            // Mostrar la sección correspondiente
            if (opcion == "1") {
                document.getElementById("arica").classList.add("active");
            } else if (opcion == "2") {
                document.getElementById("tarapaca").classList.add("active");
            } else if (opcion == "3") {
                document.getElementById("antofagasta").classList.add("active");
            } else if (opcion == "4") {
                document.getElementById("atacama").classList.add("active");
            } else if (opcion == "5") {
                document.getElementById("coquimbo").classList.add("active");
            } else if (opcion == "6") {
                document.getElementById("valparaiso").classList.add("active");
            } else if (opcion == "7") {
                document.getElementById("ohiggins").classList.add("active");
            } else if (opcion == "8") {
                document.getElementById("maule").classList.add("active");
            } else if (opcion == "9") {
                document.getElementById("nuble").classList.add("active");
            } else if (opcion == "10") {
                document.getElementById("biobio").classList.add("active");
            } else if (opcion == "11") {
                document.getElementById("araucania").classList.add("active");
            } else if (opcion == "12") {
                document.getElementById("rios").classList.add("active");
            } else if (opcion == "13") {
                document.getElementById("lagos").classList.add("active");
            } else if (opcion == "14") {
                document.getElementById("aysen").classList.add("active");
            } else if (opcion == "15") {
                document.getElementById("magallanes").classList.add("active");
            } 
          
        }
