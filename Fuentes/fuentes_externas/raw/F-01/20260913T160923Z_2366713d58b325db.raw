            background-color:#ffffff;
            margin-bottom: 10px;
            cursor: pointer;
        }

        .content-section {
           display: none;
           color: #fff;
           background: #243752;
           padding: 10px 13px 10px 13px;
           border-radius: 6px;
           font-size: 13px;
        }

