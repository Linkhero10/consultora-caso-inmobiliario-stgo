	<link rel='archives' title='Mayo 2010' href='https://www.chilecompra.cl/2010/05/' />
	<link rel='archives' title='Abril 2010' href='https://www.chilecompra.cl/2010/04/' />
	<link rel='archives' title='Marzo 2010' href='https://www.chilecompra.cl/2010/03/' />
	<link rel='archives' title='Febrero 2010' href='https://www.chilecompra.cl/2010/02/' />
	<link rel='archives' title='Enero 2010' href='https://www.chilecompra.cl/2010/01/' />
    <script>
        $(document).ready(function(){
            $(".contenedor_acordeon span").addClass("boton-mas");
            
            $('.bxslider').bxSlider({
                auto: false,
                autoStart: false
            });
            
            $('.bxslider-logos').bxSlider({
                minSlides: 1,
              maxSlides: 10,
              auto: false,
              moveSlides: 1,
              slideWidth: 160,
              slideMargin: 70,
              pager: false,
              controls: true,
              nextText: '>',
              prevText: '<',
              responsive: true
            });
            
            $(".bxslider-alianzas").bxSlider({
                auto: true,
                autoStart: true,
                responsive: true,
                minSlides: 1,
                maxSlides: 4,
                moveSlides: 1,
                slideWidth: 230,
                slideMargin: 30,
                pager: false,
                controls: false
            });
            
            $(".fancybox").fancybox();
            $(".various").fancybox({
                maxWidth	: 800,
                maxHeight	: 450,
                fitToView	: false,
                width		: '70%',
                minHeight	: 300,
                autoSize	: false,
                closeClick	: false,
                openEffect	: 'none',
                closeEffect	: 'none'
            });

            $(".contenedor_acordeon").on("click", function(){
                if ($(this).hasClass("fondo_azul")) {
                    $(this).next(".contenedor_contenido_acordeon").slideUp();
                    $(this).removeClass("fondo_azul");
                    $(this).find("span").removeClass("boton-menos").addClass("boton-mas");
                    $(".contenedor_acordeon").removeClass("fondo_azul");
                    $(".contenedor_acordeon").find("span").removeClass("boton-menos").addClass("boton-mas");
                } else {
                    $(".contenedor_acordeon").removeClass("fondo_azul");
                    $(".contenedor_contenido_acordeon").slideUp();
                    $(this).addClass("fondo_azul");
                    $(".contenedor_acordeon").find("span").removeClass("boton-menos").addClass("boton-mas");
                    $(this).find("span").removeClass("boton-mas").addClass("boton-menos");
                    $(this).next(".contenedor_contenido_acordeon").slideDown();
                }
            });
            
            $( "article.centro-de-documentacion a:contains('Descarga')" ).addClass( "btn btn-success" );
            $( "article.documentos a:contains('Descarga')" ).addClass( "btn btn-success" );
            $( "article.boletin-chilecompra a:contains('Descarga')" ).addClass( "btn btn-success" );
            
            // Organizar y mover Eventos en Calendario
            var mes = $("#mes-actual").val();
            var mover_evento_anterior = "";
            var ev = 0, ad = 0;
            $(".container_event").each(function(){
                var categoria = "";
                var mes_aux = $(this).find(".mes-evento").val();
                if (mes_aux === mes) {
                    $(this).removeClass("ocultar_evento").addClass("mostrar_evento");
                    mover_evento = $(this).find(".id-evento").val();
                    /*alert(mes+" "+mes_aux+" "+mover_evento);*/
                    if (mover_evento_anterior != mover_evento) {
                        ev = 0;
                        ad = 0;
                        $('<div class="marcador_eventos"></div>').appendTo("#"+mover_evento);
                        var alerta = $("#"+mover_evento);
                        for (var i = 1; i < 8; i++) {
                            if (alerta.hasClass("end")) {
                                i = 8;
                            } else {
                                alerta = alerta.next();
                            }
                        }
                        $('<li id="'+mover_evento+'-id" class="number_events"></li>').insertAfter(alerta);
                    } else {
                        if ($(this).hasClass("eventos") && ev == 0) {
                            $('<span class="eventos"></span>').appendTo("#"+mover_evento+" .marcador_eventos");
                            ev = 1;
                        }
                        if ($(this).hasClass("agenda-directora") && ad == 0) {
                            $('<span class="agenda-directora"></span>').appendTo("#"+mover_evento+" .marcador_eventos");
                            ad = 1;
                        }
                    }
                    if ($(this).hasClass("eventos") && ev == 0) {
                        $('<span class="eventos"></span>').appendTo("#"+mover_evento+" .marcador_eventos");
                        ev = 1;
                    }
                    if ($(this).hasClass("agenda-directora") && ad == 0) {
                        $('<span class="agenda-directora"></span>').appendTo("#"+mover_evento+" .marcador_eventos");
                        ad = 1;
                    }
                    $(this).appendTo("#"+mover_evento+"-id");
                    mover_evento_anterior = mover_evento;
                } else {
                    $(this).remove();
                }
            });
            
            $("#calendar ul.dates li").on("click", function(e){
                e.preventDefault();
                $("#calendar ul.dates li").removeClass("evento_select");
                var id_aux = $(this).attr("id");
                $(".number_events").removeClass("mostrar_evento_select");
                $("#"+id_aux+"-id").addClass("mostrar_evento_select");
                $(this).addClass("evento_select");
            });
            
            $("#control_tabulador li").on("click", function(e){
                e.preventDefault;
                var id_aux = $(this).attr("id");
                if (!$(this).hasClass("tab_seleccionado")) {
                    $("#control_tabulador li").removeClass("tab_seleccionado");
                    $(this).addClass("tab_seleccionado");
                    $("#tabulador div.tab_content").removeClass("mostrar_content_tab").addClass("ocultar_content_tab");
                    $("#"+id_aux+"_tab").removeClass("ocultar_content_tab").addClass("mostrar_content_tab");
                }
            });
            
            //Show/hide events on home page
            /* var mes_actual_home = $(".mes-actual").val();
            var dia_actual_home = $(".dia-actual").val();
            $("#eventos_inicio article").each(function(){
                var mes_actual_articulo = $(this).find(".mes-evento-home").val();
                var dia_actual_articulo = $(this).find(".dia-evento-home").val();
                if (mes_actual_articulo == mes_actual_home) {
                    if (dia_actual_articulo >= dia_actual_home) {
                        $(this).addClass("mostrar_content_tab");
                    } else {
                        $(this).addClass("ocultar");
                    }
                } else {
                    $(this).addClass("ocultar");
                }
            }); */
            
            /*Sort events on home page
            var contador_orden_incio = 0;
            $("#eventos_inicio article").each(function(){
                var _this = $(this);
                var operador_actual = _this.find(".dia-evento-home").val();
                $("#eventos_inicio article").each(function(){
                    var operador_anterior = $(this).find(".dia-evento-home").val();
                    if ((operador_actual > operador_anterior) && (contador_orden_incio < 3)) {
                        _this.insertAfter($(this));
                        contador_orden_incio = contador_orden_incio + 1;
                    }
                });
            }); */
            
            /*Subir*/
            $("#boton_subir").on("click", function(e){
                e.preventDefault;
                $("html").scrollView();
            });
            
            /*Volver*/
            $("#boton_volver").on("click", function(e){
                e.preventDefault;
                history.go(-1);
                return false;
            });
            
            $(".direccion").addClass("fondo_azul");
            $(".direccion").next(".contenedor_contenido_acordeon").css("display", "block").addClass("boton-menos");
            
            if ($("#menu-normativa").length) {
                $("#menu-item-513").addClass("current-menu-parent");
            }
            
            if ($("#menu-institucional").length) {
                $("#menu-item-513").addClass("current-menu-parent");
            }
            
            $("#sandwich").on("click", function(e){
                e.preventDefault();
                $("#menu-principal").slideToggle();
                $(this).toggleClass("sandwich_visible");
            });
            
                $("#menu-principal .menu-item-has-children > a").on("click", function(e){
                    if ($("#sandwich").hasClass("sandwich_visible")) {
                    e.preventDefault();
                    if ($(this).next(".sub-menu").is(":visible")) {
                        $(".sub-menu").slideUp();
                    } else {
                        $(".sub-menu").slideUp();
                        $(this).next(".sub-menu").slideToggle();
                    }
                    }
                });
            
            $("#header_menu_lateral").on("click", function(){
                $("nav.menu-lateral").slideToggle();
                $(this).toggleClass("open_menu_lateral");
            });
            
            $("#control_mei div").on("click", function(e){
                e.preventDefault();
                var clase = $(this).attr("class");
                $("#control_mei div").removeClass("seleccionado");
                $(this).addClass("seleccionado");
                $(".box_mei").removeClass("mostrar_content_tab").addClass("ocultar_content_tab");
                $("#"+clase).removeClass("ocultar_content_tab").addClass("mostrar_content_tab");
            });
            
            //Controles + -
            $("#aumentar").on("click", function(e){
                e.preventDefault();
                var tamanho_font_body = $("body").css("font-size");
                tamanho_font_body = tamanho_font_body.replace ( /[^\d.]/g, '' );
                tamanho_font_body = parseInt(tamanho_font_body);
                if (tamanho_font_body >= 16 && tamanho_font_body < 21) {
                    tamanho_font_body = tamanho_font_body + 1;
                    tamanho_font_body = tamanho_font_body.toString()+"px";
                    $("body").css("font-size", tamanho_font_body);
                }
            });
            $("#disminuir").on("click", function(e){
                e.preventDefault();
                var tamanho_font_body = $("body").css("font-size");
                tamanho_font_body = tamanho_font_body.replace ( /[^\d.]/g, '' );
                tamanho_font_body = parseInt(tamanho_font_body);
                if (tamanho_font_body <= 21 && tamanho_font_body > 16) {
                    tamanho_font_body = tamanho_font_body - 1;
                    tamanho_font_body = tamanho_font_body.toString()+"px";
                    $("body").css("font-size", tamanho_font_body);
                }
            });

            //Alto Contraste
            $("#contraste").on("click", function(e){
                e.preventDefault();
                if ($("body").hasClass("contraste")) {
                    $("body").removeClass("contraste");
                } else {
                    $("body").addClass("contraste");
                }
            });
            
            $("#control_tabulador a").on("click", function(e){
                e.preventDefault();
            });

            var contador_servicios = 1;
            $("#servicios_inicio .articulo_3_col").each(function(){
                if (contador_servicios == 1) {
                    $(this).find("a").attr('target', '_blank');
                    contador_servicios += 1;
                } else {
                    return false;
                }
            });

            $("#destacado_secundario a").attr('target', '_blank');           

        });
    </script>
