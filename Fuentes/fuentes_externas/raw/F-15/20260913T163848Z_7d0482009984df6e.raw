<style id="wp-custom-css">
#barra_superior_chc{
	display:block
}
 
nav.menu_chc {
    width: 100%;
    max-width: 1240px;
    text-align: right;
    margin: 0 auto;
    position: relative;
    top: -4px;
    box-sizing: border-box;
    padding: 0 12px;
}
 
 
/* menu_chc: tablet y móvil */
@media (max-width: 1240px) {
    nav.menu_chc ul li {
        padding: 5px 10px 0 10px;
    }
}
 
@media (max-width: 790px) {
    #barra_superior_chc {
        text-align: center;
    }
    nav.menu_chc {
        top: 0;
        padding: 0 8px 8px;
        text-align: center;
    }
    nav.menu_chc ul.menu_chc_container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: stretch;
        gap: 0;
    }
    nav.menu_chc ul li {
        flex: 1 1 100%;
        max-width: 100%;
        margin-right: 0;
        padding: 10px 12px 8px;
        box-sizing: border-box;
        border-top-width: 3px;
    }
    nav.menu_chc ul li:hover {
        border-top-width: 3px;
    }
    nav.menu_chc ul li.botones_superior {
        flex: 1 1 calc(33.333% - 4px);
        min-width: 0;
        max-width: none;
        border: none !important;
        padding: 10px 6px !important;
    }
    nav.menu_chc a {
        font-size: 0.95em;
        display: inline-block;
        padding: 2px 0;
    }
}
.recent-post-slider .post-title {
    display: none !important;
}
</style>
