<script>
document.addEventListener('DOMContentLoaded', function() {
    var popupLinks = document.querySelectorAll('.popup-widget-link');
    popupLinks.forEach(function(link) {
        link.addEventListener('click', function(event) {
            event.preventDefault();

            var pageId = this.getAttribute('data-id');
            var imageUrl = this.getAttribute('data-image');

            if (!pageId) {
                console.error('No se proporcionó un ID de página.');
                return;
            }

            var modal = document.createElement('div');
            modal.classList.add('modal');

            var modalOverlay = document.createElement('div');
            modalOverlay.classList.add('modal-overlay');
            document.body.appendChild(modalOverlay);

            fetch('/?page_id=' + pageId)
                .then(response => response.text())
                .then(html => {
                    modal.innerHTML = '<div class="modal-content">' + html + '<span class="modal-close">&times;</span></div>';
                    document.body.appendChild(modal);
                    modal.classList.add('open');
                    modalOverlay.classList.add('open');
                })
                .catch(error => {
                    console.error('Error al recuperar el contenido:', error);
                });

            modal.addEventListener('click', function(e) {
                if (e.target.classList.contains('modal-close')) {
                    document.body.removeChild(modal);
                    modalOverlay.classList.remove('open'); // Quitar clase al cerrar el modal
                }
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    document.body.removeChild(modal);
                    modalOverlay.classList.remove('open'); // Quitar clase al cerrar el modal
                }
            });

            // Cierra el popup al hacer clic fuera de él
            modalOverlay.addEventListener('click', function() {
                document.body.removeChild(modal);
                modalOverlay.classList.remove('open'); // Quitar clase al cerrar el modal
            });
        });
    });
});


</script>

<script>
        function openPopup(link) {
            // Muestra el overlay y el popup
            document.getElementById('popupOrganigrama').style.display = 'flex';
            
            // Muestra el botón de cerrar después de cargar el contenido
            document.querySelector('.closeBtn').style.display = 'none';

            // Muestra el indicador de carga mientras se obtiene el contenido
            document.getElementById('loadingIndicator').style.display = 'block';

            // Utiliza fetch para obtener el contenido de la URL
            fetch(link)
                .then(response => response.text())
                .then(data => {
                    // Coloca el contenido dentro del div de popup
                    document.getElementById('popupContent').innerHTML = data;
                    // Oculta el indicador de carga
                    document.getElementById('loadingIndicator').style.display = 'none';
                    // Muestra el botón de cerrar después de cargar el contenido
                    document.querySelector('.closeBtn').style.display = 'block';
                })
                .catch(error => {
                    console.error('Error al obtener el contenido:', error);
                    // Puedes manejar el error mostrando un mensaje adecuado al usuario
                    document.getElementById('loadingIndicator').innerHTML = 'Error al cargar el contenido.';
                });
        }

        function closePopup() {
            // Oculta el overlay y limpia el contenido del popup
            document.getElementById('popupOrganigrama').style.display = 'none';
            document.getElementById('popupContent').innerHTML = '';
            // Oculta el botón de cerrar para la próxima apertura del popup
            document.querySelector('.closeBtn').style.display = 'none';
        }
</script>

