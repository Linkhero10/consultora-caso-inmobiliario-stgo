        </section>
<footer role="contentinfo" aria-label="footer">
	<div id="contenedor_footer" class="clearfix">
		<div class="contenedor_footer_interno">
			<figure>
			<a href="https://www.chilecompra.cl/"><img src="https://www.chilecompra.cl/wp-content/themes/chcptemp/images/LogoChC_footerweb.png" title="logo Chilecompra" alt="pagina principal Chilecompra" width="85%"></a>
			</figure>
			<h3>Dirección ChileCompra</h3>
