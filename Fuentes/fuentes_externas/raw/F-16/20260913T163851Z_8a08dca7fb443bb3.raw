    <script>
        document
            .getElementById("accessibilidadGris")
            .addEventListener("click", changeGrayScale);
        document
            .getElementById("accessibilidadAumentar")
            .addEventListener("click", changeFontSizePlus);
        document
            .getElementById("accessibilidadDisminuir")
            .addEventListener("click", changeFontSizeMinus);
        document
            .getElementById("accessibilidadContraste")
            .addEventListener("click", changeContrast);
        document
            .getElementById("accessibilidadRestaurar")
            .addEventListener("click", restoreAccessibility);
        function saveAccessibility(font, grey, contrast){
            const accessibilityObj = {
                font: font,
                grey: grey,
                contrast: contrast
            }
            localStorage.setItem('accessibility', JSON.stringify(accessibilityObj))
        }

        function loadAccessibility(){
            const storedUserData = JSON.parse(localStorage.getItem('accessibility'));
            if(storedUserData == null){
                return;
            }

            if(storedUserData.font){
                changeFontSizePlus();
            }
            if(storedUserData.contrast){
                changeContrast();
            }
            if(storedUserData.grey){
                changeGrayScale();
            }
            saveAccessibility(storedUserData.font, storedUserData.grey, storedUserData.contrast);
        }
        loadAccessibility();
        function restoreAccessibility(event){
            localStorage.removeItem('accessibility');
            if(document.body.classList.contains("blackBackground")){
                changeContrast();
            }
            if (document.body.classList.contains("lobby-grayscale")) {
                document.body.classList.toggle("lobby-grayscale");
            }
            changeFontSizeMinus();
            saveAccessibility(false, false, false);
        }
        function changeGrayScale(event) {
            let storedUserData = localStorage.getItem('accessibility');
            if(storedUserData == null){
                saveAccessibility(false, true, false);
            }else{
                storedUserData = JSON.parse(localStorage.getItem('accessibility'));
                saveAccessibility(storedUserData.font, !storedUserData.grey, storedUserData.contrast);
            }
            if(document.body.classList.contains("blackBackground")){
                changeContrast();
                saveAccessibility(storedUserData.font, !storedUserData.grey, false);
            }
            document.body.classList.toggle("lobby-grayscale");

        }

        function changeFontSizePlus(event) {
            let storedUserData = localStorage.getItem('accessibility');
            if(storedUserData == null){
                saveAccessibility(true, false, false);
            }else{
                storedUserData = JSON.parse(localStorage.getItem('accessibility'));
                saveAccessibility(true, storedUserData.grey, storedUserData.contrast);
            }
            document.documentElement.style.fontSize = "140%";
            if (document.getElementById("navRrss")) {
                document.getElementById("navRrss").style.height = "186px";
            }
        }

        function changeFontSizeMinus(event) {
            let storedUserData = localStorage.getItem('accessibility');
            if(storedUserData == null){
                saveAccessibility(false, false, false);
            }else{
                storedUserData = JSON.parse(localStorage.getItem('accessibility'));
                saveAccessibility(false, storedUserData.grey, storedUserData.contrast);
            }
            document.documentElement.style.fontSize = "100%";
            if (document.getElementById("navRrss")) {
                document.getElementById("navRrss").style.height = "136px";
            }
        }


        function changeContrast(event) {
            let storedUserData = localStorage.getItem('accessibility');
            if(storedUserData == null){
                saveAccessibility(false, false, true);
            }else{
                storedUserData = JSON.parse(localStorage.getItem('accessibility'));
                saveAccessibility(storedUserData.font, storedUserData.grey, !storedUserData.contrast);
            }
            if (document.body.classList.contains("lobby-grayscale")) {
                document.body.classList.toggle("lobby-grayscale");
                saveAccessibility(storedUserData.font, false, !storedUserData.contrast);
            }
            document.body.classList.toggle("blackBackground");
            document.body.classList.toggle("high-contrast");
            document.querySelector('footer').classList.toggle("blackBackground");
            document.querySelector('footer').classList.toggle("high-contrast");
            document.getElementById("navMenu").classList.toggle("blackBackground");
            document.getElementById("navRrss").classList.toggle("blackBackground");
            let elements = document.querySelectorAll('div.card-body').forEach((el) => {
                el.classList.toggle("blackBackground");
            });
        }
    </script>
    <script src="https://www.leylobby.gob.cl/js/jquery/dist/jquery.min.js"></script>
    <script>
    $(document).ready(function() {

            $('.navbar-toggler').on('click', function() {
                $('#overlay').toggle();
            });
        });

    </script>


    <script>
      $(function() {
        // Cuando una pestaña termina de mostrarse…
        $('a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
          // Obtenemos el selector del panel destino (ej. "#acerca-de")
          var targetSelector = $(e.target).attr('href');
          var $targetPane    = $(targetSelector);

          if ($targetPane.length) {
            // Desplaza la página de forma suave hasta 100px por encima del panel
            $('html, body').animate({
              scrollTop: $targetPane.offset().top - 100
            }, 400); // Duración: 600 ms (ajústalo a tu gusto)
          }
        });
      });
    </script>
</body>

</html>
