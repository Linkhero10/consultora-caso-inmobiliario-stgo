<!DOCTYPE html><html lang="es-CL"> <head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta http-equiv="content-security-policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com; font-src 'self' data:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com; object-src 'none'; base-uri 'self'; form-action 'none'"><title>Inicio — IDE Chile</title><meta name="description" content="Portal institucional de la Infraestructura de Datos Espaciales de Chile (SNIT): gobernanza, políticas territoriales, estándares, capacitaciones y noticias."><link rel="canonical" href="https://www.ide.cl/"><link rel="preload" as="font" type="font/woff2" href="/_astro/inter-latin-wght-normal.Dx4kXJAl.woff2" crossorigin><link rel="preload" as="font" type="font/woff2" href="/_astro/plus-jakarta-sans-latin-wght-normal.eXO_dkmS.woff2" crossorigin><link rel="icon" type="image/png" sizes="32x32" href="/favicon.png"><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"><meta name="generator" content="Astro v5.18.2"><meta property="og:type" content="website"><meta property="og:title" content="Inicio — IDE Chile"><meta property="og:description" content="Portal institucional de la Infraestructura de Datos Espaciales de Chile (SNIT): gobernanza, políticas territoriales, estándares, capacitaciones y noticias."><meta property="og:url" content="https://www.ide.cl/"><meta property="og:locale" content="es_CL"><meta property="og:site_name" content="IDE Chile"><meta name="twitter:card" content="summary"><script>
      (() => {
        const raiz = document.documentElement;

        /*
          Marca de que hay JavaScript, antes del primer pintado.

          La cabecera flotante de la portada sale transparente del servidor y es
          un `IntersectionObserver` quien le devuelve el fondo al pasar el Hero.
          Sin JavaScript ese observador no existe y el menú quedaría en blanco
          sobre el contenido claro, así que la regla que la vuelve transparente
          cuelga de este atributo. Al ponerlo aquí, y no al hidratar, no hay
          parpadeo.
        */
        raiz.dataset.js = '';

        try {
          const p = JSON.parse(localStorage.getItem('ide-a11y') || '{}');
          /*
            El tema por defecto es el claro, y no se consulta
            `prefers-color-scheme`. Es una decisión institucional: el portal se
            presenta siempre igual a quien llega por primera vez.

            Tiene un coste que conviene conocer: quien tenga su sistema en
            oscuro —a veces por sensibilidad a la luz, no por gusto— recibe una
            página clara la primera vez. Lo compensa el widget de accesibilidad,
            que permite cambiarlo y guarda la elección para las siguientes
            visitas.

            **Este valor está duplicado en `AccessibilityWidget.tsx`**, y tiene
            que ser el mismo. Si divergen, la página se pinta con un tema y el
            interruptor del widget marca el otro.
          */
          const tema = p.tema ?? 'claro';

          if (tema === 'oscuro') raiz.classList.add('dark');
          if (tema === 'alto-contraste') raiz.dataset.contraste = 'alto';
          if (p.dislexia) raiz.dataset.dislexia = 'true';
          if (p.espaciado) raiz.dataset.espaciado = 'amplio';
          // Se refleja también 'normal': es la señal de que el usuario
          // desactivó la reducción de movimiento a propósito.
          if (p.movimiento) raiz.dataset.movimiento = p.movimiento;
          if (p.enlaces) raiz.dataset.enlaces = 'destacados';
          if (p.escalaFuente) {
            raiz.style.setProperty('--a11y-escala-fuente', String(p.escalaFuente));
          }
        } catch {
          /* localStorage no disponible: se usan los valores por defecto. */
        }
      })();
    </script><script>(function(){const gaId = "G-Y21BLC1V2F";

        (() => {
          const cargar = () => {
            const s = document.createElement('script');
