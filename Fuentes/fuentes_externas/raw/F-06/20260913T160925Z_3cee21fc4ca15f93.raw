          else window.addEventListener('load', () => setTimeout(cargar, 1200));
        })();
      })();</script><link rel="stylesheet" href="/_astro/_ruta_.Bv37v3wI.css">
<style>article[data-astro-cid-ibl2wg7k]{position:relative}
</style></head> <body class="flex min-h-dvh flex-col"> <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a> <header data-pagefind-ignore data-sobre-hero class="z-50 border-b border-slate-200/60 bg-white/85 backdrop-blur-md transition-colors dark:border-slate-800 dark:bg-slate-950/85 fixed inset-x-0 top-0 dark">  <div data-aviso-conferencia data-superficie class="bg-impulso-400 text-ide-950"><div class="mx-auto flex h-8 max-w-7xl items-center justify-center gap-x-3 overflow-hidden px-4 text-sm sm:px-6 lg:px-8"><p class="flex min-w-0 items-center gap-x-2"><span class="truncate font-semibold"><span class="hidden sm:inline">Conferencia Internacional IDE Chile 2026</span><span class="sm:hidden">Conferencia IDE Chile</span></span><span data-aviso-fecha>jueves 10 de septiembre de 2026, 08:30 horas</span><span data-aviso-digitos aria-hidden="true" class="shrink-0 items-baseline gap-x-1.5 whitespace-nowrap font-semibold tabular-nums"><span class="font-normal opacity-60">·</span><span><span data-aviso-dias>0</span><span class="font-normal">d</span></span><span><span data-aviso-horas>00</span><span class="font-normal">h</span></span><span><span data-aviso-minutos>00</span><span class="font-normal">m</span></span><span><span data-aviso-segundos>00</span><span class="font-normal">s</span></span></span><span data-aviso-plazo aria-hidden="true" class="shrink-0 whitespace-nowrap font-semibold"></span></p></div></div><script>(function(){const INICIO = "2026-09-10T11:30:00Z";
const FIN = "2026-09-10T17:00:00Z";

      (() => {
        const aviso = document.querySelector('[data-aviso-conferencia]');
        if (!aviso) return;

        const raiz = document.documentElement;
        const inicio = Date.parse(INICIO);
        const fin = Date.parse(FIN);

        /* Un solo atributo apaga las dos cosas: la banda y su hueco. */
        const ocultar = () => {
          raiz.dataset.avisoCerrado = '';
        };

        const dias = aviso.querySelector('[data-aviso-dias]');
        const horas = aviso.querySelector('[data-aviso-horas]');
        const minutos = aviso.querySelector('[data-aviso-minutos]');
        const segundos = aviso.querySelector('[data-aviso-segundos]');
        const plazo = aviso.querySelector('[data-aviso-plazo]');
        const dosCifras = (n) => String(n).padStart(2, '0');

        /* `· ` delante porque el punto que separa del rótulo vive dentro de la
           pieza de dígitos, y en modo texto ésa no se ve. */
        const modoTexto = (texto) => {
          plazo.textContent = `· ${texto}`;
          aviso.dataset.modo = 'texto';
        };

        let tic;
        let retirada;

        const pintar = () => {
          const restante = inicio - Date.now();

          if (restante <= 0) {
            /* Ya no hay nada que contar: el tic de un segundo sobra. */
            clearInterval(tic);

            if (Date.now() >= fin) {
              ocultar();
            } else {
              modoTexto('es hoy');

              /*
                Y la retirada se agenda para la hora de término.

                Sin esto, quien abriera la página durante la conferencia se
                quedaría con un «es hoy» permanente: el intervalo acaba de
                pararse y nadie volvería a mirar el reloj hasta la siguiente
                recarga. `setTimeout` admite de sobra las horas que faltan.
              */
              clearTimeout(retirada);
              retirada = setTimeout(ocultar, fin - Date.now());
            }
            return;
          }

          const total = Math.floor(restante / 1000);
          dias.textContent = String(Math.floor(total / 86400));
          horas.textContent = dosCifras(Math.floor(total / 3600) % 24);
          minutos.textContent = dosCifras(Math.floor(total / 60) % 60);
          segundos.textContent = dosCifras(total % 60);
        };

        /*
          Movimiento reducido: la cuenta no corre.

          Sin botón de cerrar, ésta es la única forma de parar un contenido que
          se actualiza solo, y DISENO §8 la exige (WCAG 2.2.2). No basta con
          congelar los dígitos: unos segundos parados en «40s» serían un dato
          falso. Se pinta una vez el plazo en días, que a esa escala no envejece
          dentro de una visita.

          La preferencia llega por dos vías, igual que en el Hero: el sistema
          (`prefers-reduced-motion`) y el widget A11y, que escribe
          `data-movimiento` en <html>. Se observa el atributo para que el cambio
          surta efecto en el momento, sin recargar.
        */
        const quieto = () =>
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          raiz.dataset.movimiento === 'reducido';

        const arrancar = () => {
          clearInterval(tic);

          if (!quieto()) {
            /* `pintar` decide solo si toca contar o pasar a modo texto. */
            delete aviso.dataset.modo;
            pintar();
            tic = setInterval(pintar, 1000);
            return;
          }

          const restante = inicio - Date.now();
          if (restante <= 0) {
            if (Date.now() >= fin) ocultar();
            else modoTexto('es hoy');
            return;
          }

          /*
            `floor` y no `ceil`, para que el plazo diga lo mismo que la cuenta
            viva: con 5 días y 14 horas por delante el contador marca «5d», y un
            redondeo hacia arriba anunciaría 6. El caso de menos de 24 horas se
            nombra aparte: «falta 1 día» a media hora del comienzo sería falso.
          */
          const dias = Math.floor(restante / 86400000);
          modoTexto(
            dias === 0
              ? 'falta menos de un día'
              : dias === 1
                ? 'falta 1 día'
                : `faltan ${dias} días`,
          );
        };

        arrancar();

        matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', arrancar);
        new MutationObserver(arrancar).observe(raiz, {
          attributes: true,
          attributeFilter: ['data-movimiento'],
        });
      })();
    })();</script>  <div class="mx-auto flex h-18 max-w-7xl items-center gap-6 px-4 sm:px-6 lg:px-8"> <a href="/" class="flex shrink-0 items-center gap-4 font-display text-lg font-bold tracking-tight
