      document.addEventListener('DOMContentLoaded', () => {
        const cabecera = document.querySelector('header[data-sobre-hero]');
        const hero = document.querySelector('[data-hero]');
        if (!cabecera || !hero) return;

        /*
          El `rootMargin` se fija al construir el observador, pero la comparación
          se hace con el alto del momento: el aviso de la conferencia se puede
          cerrar durante la visita, y con el número congelado la cabecera cambiaría de
          piel 32px tarde. El `rootMargin` puede quedarse con el alto inicial
          porque con un Hero a pantalla completa dispara muy lejos de ese umbral.
        */
        const alto = cabecera.offsetHeight;
        new IntersectionObserver(
          ([entrada]) => {
            const sobreHero = entrada.boundingClientRect.bottom > cabecera.offsetHeight;
            cabecera.toggleAttribute('data-sobre-hero', sobreHero);
            cabecera.classList.toggle('dark', sobreHero);
          },
          { rootMargin: `-${alto}px 0px 0px 0px`, threshold: 0 },
        ).observe(hero);
      });
    </script>  <script>
  (() => {
    const cabecera = document.querySelector('header[data-pagefind-ignore]');
    if (!cabecera) return;

    let pendiente = false;
    const marcar = () => {
      pendiente = false;
      cabecera.toggleAttribute('data-compacta', window.scrollY > 8);
    };

    marcar();
    addEventListener(
      'scroll',
      () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(marcar);
      },
      { passive: true },
    );
  })();
