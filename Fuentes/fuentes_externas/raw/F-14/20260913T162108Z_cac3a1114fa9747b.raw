{"data": [{"code": "consecutive_days_over_25C", "name": "Olas de calor > 25\u00baC", "description": "N\u00famero de d\u00edas que la temperatura m\u00e1xima diaria supera 25 \u00baC durante 3 o m\u00e1s d\u00edas seguidos", "units": "dias", "delta_fn": "abs"}, {"code": "consecutive_days_over_28C", "name": "Olas de calor > 28\u00baC", "description": "N\u00famero de d\u00edas que la temperatura m\u00e1xima diaria supera 28 \u00baC durante 3 o m\u00e1s d\u00edas seguidos", "units": "dias", "delta_fn": "abs"}, {"code": "consecutive_days_over_30C", "name": "Olas de calor > 30\u00baC", "description": "N\u00famero de d\u00edas que la temperatura m\u00e1xima diaria supera 30 \u00baC durante 3 o m\u00e1s d\u00edas seguidos", "units": "dias", "delta_fn": "abs"}, {"code": "consecutive_summer_days", "name": "D\u00edas consecutivos de verano", "description": "N\u00famero m\u00e1ximo de d\u00edas consecutivos donde la temperatura m\u00e1xima supera los 25\u00b0C, que da cuenta de la extensi\u00f3n del periodo c\u00e1lido", "units": "dias", "delta_fn": "abs"}, {"code": "daily_temperature_range", "name": "Amplitud t\u00e9rmica", "description": "Valor medio de la amplitud t\u00e9rmica diaria (Tmax - Tmin).", "units": "grados", "delta_fn": "abs"}, {"code": "degdays_above_15C", "name": "Grados-dia sobre 15\u00baC", "description": "Valor acumulada de la diferencia entre la temperatura media diaria y 15\u00baC.", "units": "grados-dias", "delta_fn": "abs"}, {"code": "degdays_above_20C", "name": "Grados-dia sobre 20\u00baC", "description": "Valor acumulada de la diferencia entre la temperatura media diaria y 20\u00baC", "units": "grados-dias", "delta_fn": "abs"}, {"code": "degdays_above_25", "name": "Grados-dia sobre 25\u00baC", "description": "Valor acumulada de la diferencia entre la temperatura media diaria y 25\u00baC", "units": "grados-dias", "delta_fn": "abs"}, {"code": "degdays_above_30", "name": "Grados-dia sobre 30\u00baC", "description": "Valor acumulada de la diferencia entre la temperatura media diaria y 30\u00baC", "units": "grados-dias", "delta_fn": "abs"}, {"code": "hot_days", "name": "Dias calurosos (>30\u00baC)", "description": "N\u00famero de d\u00edas en que la temperatura m\u00e1xima supera 30\u00baC.", "units": "dias", "delta_fn": "abs"}, {"code": "hottest_day", "name": "D\u00eda m\u00e1s c\u00e1lido", "description": "Temperatura (en \u00baC) del d\u00eda m\u00e1s c\u00e1lido del periodo considerado (a\u00f1o, estaci\u00f3n, mes)", "units": "\u00baC", "delta_fn": "abs"}, {"code": "mean_temperature", "name": "Temperatura media", "description": "Valor medio de la temperatura media diaria, calculado como 0.5*(Tmax + Tmin)", "units": "grados", "delta_fn": "abs"}, {"code": "ola_calor_compuesto_dmc", "name": "Ola de Calor compuesta", "description": "Ola de calor considerando la temperatura m\u00e1xima y m\u00ednima. Se define como el n\u00famero de d\u00edas cuando TX y TN est\u00e1n bajo el percentil 10 por al menos 3 d\u00edas consecutivos.", "units": "dias", "delta_fn": "abs"}, {"code": "quite_hot_days", "name": "Dias relativamente c\u00e1lidos (> 28\u00baC)", "description": "N\u00famero de d\u00edas en que la temperatura m\u00e1xima supera 28\u00baC.", "units": "dias", "delta_fn": "abs"}, {"code": "summer_days", "name": "D\u00edas de verano (> 25\u00baC)", "description": "N\u00famero de d\u00edas en que la temperatura supera 25\u00baC", "units": "dias", "delta_fn": "abs"}, {"code": "tasmax_mean", "name": "Promedio de la temperatura m\u00e1xima diaria", "description": "Promedio de la temperatura m\u00e1xima diaria", "units": "\u00baC", "delta_fn": "abs"}, {"code": "tropical_nights", "name": "Noches tropicales", "description": "N\u00famero de d\u00edas en que la temperatura m\u00ednima supera 20\u00baC", "units": "dias", "delta_fn": "abs"}, {"code": "very_hot_days", "name": "Dias muy c\u00e1lidos", "description": "N\u00famero de d\u00edas en que la temperatura supera 34\u00baC", "units": "dias", "delta_fn": "abs"}, {"code": "warm_days", "name": "D\u00edas c\u00e1lidos", "description": "N\u00famero de d\u00edas en que la temperatura supera el umbral definido como el percentil 90 de la temperatura diaria en el periodo de referencia (1980 a 2010).", "units": "dias", "delta_fn": "abs"}, {"code": "warmest_night", "name": "Noche m\u00e1s c\u00e1lida", "description": "Temperatura m\u00ednima en el d\u00eda de mayor temperatura m\u00ednima durante el periodo considerado (a\u00f1o, estaci\u00f3n, mes)", "units": "\u00baC", "delta_fn": "abs"}, {"code": "warm_nights", "name": "Noches c\u00e1lidas", "description": "N\u00famero de d\u00edas en que la temperatura m\u00ednima supera el umbral definido como el percentil 90 de la temperatura m\u00ednima diaria en el periodo de referencia (1980 a 2010).", "units": "dias", "delta_fn": "abs"}, {"code": "warm_nights_duration_index_long", "name": "Duraci\u00f3n de periodos de noches c\u00e1lidas (> 6 dias)", "description": "Numero de d\u00edas consecutivos (en cadenas de al menos 6) que la temperatura m\u00ednima supera el percentil 90.", "units": "dias", "delta_fn": "abs"}, {"code": "warm_nights_duration_index_short", "name": "Duraci\u00f3n de periodos de noches c\u00e1lidas (> 3 dias)", "description": "Numero de d\u00edas consecutivos (en cadenas de al menos 3) en que la temperatura m\u00ednima supera el percentil 90.", "units": "dias", "delta_fn": "abs"}, {"code": "warm_spell_duration_index_long", "name": "Duraci\u00f3n de episodios c\u00e1lidos (> 6 dias)", "description": "Numero de dias con al menos 6 dias consecutivos en que la temperatura m\u00e1xima supera el percentil 90.", "units": "dias", "delta_fn": "abs"}, {"code": "warm_spell_duration_index_short", "name": "Duraci\u00f3n de episodios c\u00e1lidos (> 3 dias)", "description": "Numero de dias con al menos 3 dias consecutivos en que la temperatura m\u00e1xima supera el percentil 90.", "units": "dias", "delta_fn": "abs"}, {"code": "coldest_day", "name": "D\u00eda m\u00e1s fr\u00edo", "description": "Temperatura m\u00e1xima del d\u00eda m\u00e1s fri\u00f3 del periodo considerado (a\u00f1o, estaci\u00f3n, mes)", "units": "\u00baC", "delta_fn": "abs"}, {"code": "coldest_night", "name": "Noche m\u00e1s fr\u00eda", "description": "Temperatura de la noche m\u00e1s fr\u00eda (temperatura m\u00ednima) del periodo considerado (a\u00f1o, estaci\u00f3n, mes)", "units": "\u00baC", "delta_fn": "abs"}, {"code": "cold_spell_duration_index_long", "name": "Duraci\u00f3n de episodios fr\u00edos (> 6 d\u00edas)", "description": "Numero de d\u00edas con al menos 6 d\u00edas consecutivos en que la temperatura m\u00ednima no supera el percent\u00edl 10 de la temperatura m\u00ednima diaria en el periodo de referencia (1980 a 2010).", "units": "dias", "delta_fn": "abs"}, {"code": "cold_spell_duration_index_short", "name": "Duraci\u00f3n de episodios fr\u00edos (> 3 d\u00edas)", "description": "Numero de d\u00edas con al menos 6 d\u00edas consecutivos en que la temperatura m\u00ednima no supera el percent\u00edl 10 de la temperatura m\u00ednima diaria en el periodo de referencia (1980 a 2010).", "units": "dias", "delta_fn": "abs"}, {"code": "cool_days", "name": "D\u00edas fr\u00edos", "description": "Numero de d\u00edas en que la temperatura m\u00e1xima en menor que el percent\u00edl 10.", "units": "dias", "delta_fn": "abs"}, {"code": "cool_nights", "name": "Noches fr\u00edas", "description": "Numero de d\u00edas en que la temperatura m\u00ednima en menor que el percent\u00edl 10.", "units": "dias", "delta_fn": "abs"}, {"code": "degdays_below_0c", "name": "Grados-dia bajo 0\u00baC", "description": "Valor acumulada de la diferencia entre 0\u00b0C y  temperatura media diaria", "units": "grados-dias", "delta_fn": "abs"}, {"code": "degdays_below_10C", "name": "Grados-dia bajo 10\u00baC", "description": "Valor acumulada de la diferencia entre 10\u00b0C y  temperatura media diaria", "units": "grados-dias", "delta_fn": "abs"}, {"code": "degdays_below_15C", "name": "Grados-dia bajo 15\u00baC", "description": "Valor acumulada de la diferencia entre 15\u00b0C y  temperatura media diaria", "units": "grados-dias", "delta_fn": "abs"}, {"code": "degdays_below_17_heating", "name": "Grados d\u00eda de calefacci\u00f3n (17\u00b0C)", "description": "Suma entre la diferencia de la temperatura media y 17\u00b0C", "units": "grados-dias", "delta_fn": "abs"}, {"code": "degdays_below_5C", "name": "Grados-dia bajo 5\u00baC", "description": "Valor acumulada de la diferencia entre 5\u00b0C y  temperatura media diaria", "units": "grados-dias", "delta_fn": "abs"}, {"code": "frost_days", "name": "D\u00edas de  escarcha", "description": "N\u00famero de d\u00edas en que la temperatura m\u00ednima es menor que 0\u00baC", "units": "dias", "delta_fn": "abs"}, {"code": "frost_days_below_minus_2_degrees", "name": "D\u00edas de heladas bajo -2\u00b0C", "description": "N\u00famero de d\u00edas de temperatura m\u00ednima bajo -2 \u00b0C.  Este umbral de temperatura corresponde a las heladas queman los cultivos", "units": "dias", "delta_fn": "abs"}, {"code": "ice_days", "name": "D\u00edas de hielo", "description": "N\u00famero de d\u00edas en que la temperatura m\u00e1xima es menor que 0\u00baC", "units": "dias", "delta_fn": "abs"}, {"code": "max_consecutive_frost_days", "name": "Dias consecutivos de helada", "description": "N\u00famero m\u00e1ximo de dias consecutivos de temperatura m\u00ednima menor a 0\u00b0C", "units": "dias", "delta_fn": "rel"}, {"code": "ola_frio_compuesto_dmc", "name": "Ola de Fr\u00edo compuesta", "description": "Ola de fr\u00edo considerando la temperatura m\u00e1xima y m\u00ednima. Se define como el n\u00famero de d\u00edas cuando TX y TN superan el percentil 90 por al menos 3 d\u00edas consecutivos.", "units": "dias", "delta_fn": "abs"}, {"code": "tasmin_mean", "name": "Promedio de la temperatura m\u00ednima diaria", "description": "Promedio de la temperatura m\u00ednima diaria", "units": "\u00baC", "delta_fn": "abs"}, {"code": "consecutive_dry_days", "name": "D\u00edas secos consecutivos", "description": "N\u00famero m\u00e1ximo de d\u00edas consecutivos en que la precipitaci\u00f3n diaria no supera 1 mm", "units": "dias", "delta_fn": "rel"}, {"code": "consecutive_wet_days", "name": "D\u00edas h\u00famedos consecutivos", "description": "N\u00famero m\u00e1ximo de d\u00edas consecutivos en que la precipitaci\u00f3n diaria supera 1 mm", "units": "dias", "delta_fn": "rel"}, {"code": "days_over_50mm", "name": "D\u00edas sobre 50 mm", "description": "N\u00famero de d\u00edas de precipitaci\u00f3n sobre 50mm. Este \u00edndice es adecuado para impactos inundaciones, aumento de caudal, entre otros.", "units": "dias", "delta_fn": "abs"}, {"code": "drought_periods", "name": "Frecuencia de sequ\u00eda", "description": "Frecuencia de periodos en que la precipitaci\u00f3n acumulada es menor al 75% del promedio la precipitaci\u00f3n acumulada en el periodo de referencia (1980 a 2010)", "units": "%", "delta_fn": "abs"}, {"code": "eto_mean", "name": "Evapotranspiraci\u00f3n Potencial", "description": "Evaportraspiraci\u00f3n Potencial medio, calculado usado el metodo de Penman-Montieth (FAO56)", "units": "mm", "delta_fn": "abs"}, {"code": "martonne", "name": "\u00cdndice de aridez de Martonne", "description": "El \u00edndice de aridez de Martonne clasifica el clima de una regi\u00f3n seg\u00fan la precipitaci\u00f3n anual (P) y la temperatura media anual (T). Su valor se calcula dividiendo la precipitaci\u00f3n anual en mm entre la temperatura media anual en \u00b0C m\u00e1s 10. Un valor m\u00e1s alto indica un clima m\u00e1s h\u00famedo, mientras que uno m\u00e1s bajo indica aridez.", "units": "mm", "delta_fn": "abs"}, {"code": "max_5day_precip", "name": "Precipitaci\u00f3n m\u00e1xima en 5 d\u00edas", "description": "Precipitaci\u00f3n m\u00e1xima acumulada en 5 d\u00edas consecutivos", "units": "mm", "delta_fn": "abs"}, {"code": "maximum_daily_precipitation", "name": "Precipitaci\u00f3n m\u00e1xima diaria", "description": "Precipitaci\u00f3n m\u00e1xima diaria", "units": "dias", "delta_fn": "rel"}, {"code": "number_of_heavy_precipitation_days", "name": "D\u00edas de precipitaci\u00f3n intensa", "description": "N\u00famero de d\u00edas en que la precipitaci\u00f3n diaria supera 10 mm", "units": "dias", "delta_fn": "abs"}, {"code": "number_of_very_heavy_precipitation_days", "name": "D\u00edas de precipitaci\u00f3n muy intensa", "description": "N\u00famero de d\u00edas en que la precipitaci\u00f3n diaria supera 20 mm", "units": "dias", "delta_fn": "abs"}, {"code": "pr_sum", "name": "Precipitaci\u00f3n acumulada", "description": "Cantidad de precipitaci\u00f3n (lluvia y nieve) acumulada", "units": "mm", "delta_fn": "rel"}, {"code": "simple_precip_intensity_index", "name": "Indice simple de intensidad de precipitaci\u00f3n", "description": "Promedio de la precipitaci\u00f3n diaria considerando s\u00f3lo los d\u00edas en que la precipitaci\u00f3n supera 1mm/d\u00eda", "units": "mm/d\u00eda", "delta_fn": "abs"}, {"code": "spi", "name": "Standadized Precipitation Index", "description": "Standadized Precipitation Index", "units": "Z", "delta_fn": "abs"}, {"code": "rain_max", "name": "Lluvia m\u00e1xima diaria", "description": "Valor m\u00e1ximo de la lluvia (agua liquida) acumulada en un d\u00eda", "units": "mm", "delta_fn": "rel"}, {"code": "rain_sum", "name": "Lluvia acumulada", "description": "Cantidad de lluvia (agua l\u00edquida) acumulada en mil\u00edmetros durante el per\u00edodo (a\u00f1o, estaci\u00f3n, o mes)", "units": "mm", "delta_fn": "rel"}, {"code": "snow_max", "name": "Nieve m\u00e1xima diaria", "description": "Valor m\u00e1ximo de la nieve acumulada en un d\u00eda,  expresada en mm de agua equivalente", "units": "mm", "delta_fn": "rel"}, {"code": "snow_sum", "name": "Nieve acumulada", "description": "Cantidad de nieve acumulada, expresada en mm de agua equivalente", "units": "mm", "delta_fn": "rel"}, {"code": "vel_max", "name": "Viento m\u00e1ximo diario", "description": "Valor medio del m\u00e1ximo diario de la magnitud del viento", "units": "m/s", "delta_fn": "rel"}, {"code": "vel_mean", "name": "Viento medio", "description": "Valor medio de la magnitud del viento", "units": "m/s", "delta_fn": "rel"}, {"code": "hursmax_mean", "name": "Humedad relativa m\u00e1xima diaria", "description": "Valor medio de la humedad relativa (%)", "units": "%", "delta_fn": "rel"}, {"code": "hurs_mean", "name": "Humedad relativa media diaria", "description": "Valor medio del m\u00e1ximo diario de la humedad relativa (%)", "units": "%", "delta_fn": "rel"}, {"code": "hursmin_mean", "name": "Humedad relativa m\u00ednima diaria", "description": "Valor medio del m\u00ednimo diario de la humedad relativa (%)", "units": "%", "delta_fn": "rel"}, {"code": "huss_mean", "name": "Humedad espec\u00edfica", "description": "Valor medio de la humedad espec\u00edfica (g/Kg)", "units": "g/kg", "delta_fn": "rel"}, {"code": "rsds_max", "name": "Insolaci\u00f3n solar m\u00e1xima diaria", "description": "Valor m\u00e1ximo de la irradiaci\u00f3n global horizontal diaria (W/m2)", "units": "W/m2", "delta_fn": "abs"}, {"code": "rsds_mean", "name": "Insolaci\u00f3n solar diaria", "description": "Valor medio de la irradiaci\u00f3n global horizontal", "units": "W/m2", "delta_fn": "abs"}, {"code": "rsds_min", "name": "Insolaci\u00f3n solar m\u00ednima diaria", "description": "Valor m\u00ednimo de la irradiaci\u00f3n global horizontal diaria", "units": "W/m2", "delta_fn": "abs"}, {"code": "ps_mean", "name": "Presi\u00f3n atmosf\u00e9rica media", "description": "Valor medio de la presi\u00f3n atmosf\u00e9rica en superficie", "units": "hPa", "delta_fn": "abs"}]}