        <style>
            

#arclim_search_text {
    height: 50px;
    width: 400px;
    padding: 5px;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgba(255, 255, 255, 0.5);
    border: solid 1px lightgray;
    color: #553333;
    font-size:  16px;
}
#arclim_search_text:hover {
    background-color: rgba(255, 255, 255, 0.6);
}

#arclim_search_icon {
    height: 50px;
    line-height: 50px;
    font-size: 36px;
    padding: 5px 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(255, 255, 255, 0.8);
    border-top: solid 1px lightgray;
    border-right: solid 1px lightgray;
    border-bottom: solid 1px lightgray;
}
#arclim_search_icon:hover {
    background-color: rgba(255, 255, 255, 1.0);
}

#arclim_background_image {
padding: 0px; 
margin: 0px; 
min-height: 800px; 
background-size: cover; 
background-position: 50%;
background-image:  linear-gradient(to right, rgba(255,0,0,0), rgba(255,100,0,0.7)),
                   linear-gradient(rgba(40,30,150,0.1), rgba(220,220,255,0.6), rgba(255,255,255,0.9)),
                   linear-gradient(rgba(0,0,100,0.9), rgba(0,0,100,0.5), rgba(255,255,255,0.0)),
/*                   linear-gradient(rgba(0,0,100,0.9), rgba(220,220,255,0.0), rgba(255,255,255,0.0)), */
/*                   url(https://www.cambioclimaticochile.cl/wp-content/uploads/2018/01/desiertodeatacama.jpg) */
                   url(/media/shutterstock/w1200/shutterstock_96292022.jpg)
    
}

#arclim_footer {
padding: 0px;
margin: 0px;
background-size: cover;
background-position: 50%;
background-image:  linear-gradient(to right, rgba(255,0,0,0), rgba(255,100,0,0.7)),
                   linear-gradient(rgba(40,30,150,0.1), rgba(220,220,255,0.6), rgba(255,255,255,0.9)),
                   linear-gradient(rgba(0,0,100,0.9), rgba(0,0,100,0.5), rgba(255,255,255,0.0)),
                   url(/media/shutterstock/w1200/shutterstock_96292022.jpg);
color: white;
}

#arclim_search_container {
    height: 120px;
}
#arclim_search_results_container {
    height: 200px;
    display: flex;
    overflow-x: scroll;
    justify-content: left;
    background-color: rgba(255,255,255, 0.5);
}

.atlas_map_result {
    margin: 15px;
    display:flex;
    flex-direction: column; 
    min-width: 180px;
    max-width: 180px;
    background-size: cover;
    background-position: 50%;
    justify-content: center;
    box-shadow: 0px 0px 10px gray;
    opacity: 0.8;
}

.atlas_map_result:hover {
    margin-bottom: 25px;
    margin-top: 5px;
    opacity: 1;
}

.atlas_map_icon {
    font-size: 56px;
    text-align: center;
    color: rgba(255,255,255, 0.8); 
}

.atlas_map_text {
    text-align: center;
    color: white;
    font-size: 14px;
    padding: 5px;
    line-height: 1.25;
    overflow: hidden;
}

.atlas_map_link {
    font-size: 14px;
    text-align: center;
    color: white;
    font-size: 14px;
    line-height: 1;
}

#arclim_links_container {
    color:white;
    font-size: 18px;
    font-weight: bold;
    text-shadow: 0px 0px 5px gray;
    padding: 15px;
}
.arclim_link:hover {
    color: dodgerblue;
}
.upper-link {
color: white;
text-decoration: none;
}

.upper-link:hover {
color: white;
text-decoration: none;
text-shadow: 0px 0px 3px white;
}

.arclim_sector_image {
    height: 200px;
    background-size: cover;
    background-position: 50%;
    line-height: 200px; 
    font-size: 72px; 
    color: rgba(255,255,255,0.7);
    width:100%;
}
.arclim_sector_image:hover {
    color: rgba(255,255,255,0.9);
    
}
.arclim_card_title {
    color: #666666;
}
.arclim_card_title:hover {
    color: dodgerblue;
    text-decoration:none; 
    cursor:pointer;  
    height:50px;
}

.intro_text{
color:white;
padding-top: 30px;
padding-left: 100px;
padding-right: 100px;
text-shadow: 0px 0px 3px black;
font-size: 18px;
text-align: justify;
}

        </style>

