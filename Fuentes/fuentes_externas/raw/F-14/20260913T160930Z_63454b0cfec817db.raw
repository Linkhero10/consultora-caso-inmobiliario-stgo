        <div id="explorador_amenazas" class="uk-padding uk-margin">
            <!-- EXPLORADOR DE AMENAZAS -->
            <h1 class="uk-text-center" style="color:white;text-shadow: 0px 0px 10px black;"> Explorador de Amenazas</h1>
            <div class="uk-grid-match" uk-grid>
                <p class="uk-text-large" style="color:white; text-shadow: 0px 0px 5px black;">Explorador las Amenzas Climáticas que afectarán a Chile durante los próximos 50 años </p>
