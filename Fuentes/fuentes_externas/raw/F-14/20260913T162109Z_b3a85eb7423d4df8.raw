e}, {"code": "paarc_aysen_turismo_glaciar_expo", "name": "\u00cdndice de exposici\u00f3n", "description": "\u00cdndice de exposici\u00f3n, calculado como la divisi\u00f3n entre el n\u00famero de glaciares con puntos tur\u00edsticos por comuna y el mayor valor de esta variable en la regi\u00f3n", "units": null, "isnumeric": true}, {"code": "paarc_aysen_turismo_glaciar_PT", "name": "Puntos tur\u00edsticos por comuna", "description": "N\u00famero de puntos tur\u00edsticos totales presentes en la comuna", "units": null, "isnumeric": true}, {"code": "paarc_aysen_turismo_glaciar_PTglaciar", "name": "Puntos tur\u00edsticos asociados a glaciares", "description": "N\u00famero de puntos tur\u00edsticos totales presentes en la comuna, que se encuentran cercanos a glaciares", "units": null, "isnumeric": true}, {"code": "paarc_aysen_turismo_glaciar_riesgo", "name": "\u00cdndice de riesgo", "description": "\u00cdndice de riesgo calculado como Amenaza x Exposici\u00f3n x Sensibilidad", "units": null, "isnumeric": true}, {"code": "paarc_aysen_turismo_glaciar_sens", "name": "\u00cdndice de sensibilidad", "description": "\u00cdndice de sensibilidad estimado como el mayor entre ambas variables de sensibilidad", "units": null, "isnumeric": true}, {"code": "paarc_aysen_turismo_glaciar_sens_PT", "name": "Sensibilidad relacionada con cantidad de puntos tur\u00edsticos", "description": "Sensibilidad estimada como numero de puntos tur\u00edsticos asociados a glaciares en relacion al n\u00famero total de puntos tur\u00edsticos", "units": null, "isnumeric": true}, {"code": "paarc_aysen_turismo_glaciar_sens_visitas", "name": "Sensibilidad relacionada con cantidad de visitas a PN", "description": "Sensibilidad estimada como numero de visitas asociadas a glaciares en relacion al n\u00famero total de visitas a PN por comuna", "units": null, "isnumeric": true}, {"code": "paarc_aysen_turismo_glaciar_visitas", "name": "Visitas a PN", "description": "Cantidad de visitas a parques nacionales por comuna", "units": null, "isnumeric": true}, {"code": "paarc_aysen_turismo_glaciar_visitasglaciar", "name": "Visitas a PN asociadas a glaciar", "description": "Cantidad de visitas estimadas a los puntos turisticos asociados a glaciares", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_degradacionturberas_amen_precipacumulada", "name": "Variaci\u00f3n de la precipitaci\u00f3n aumulada", "description": "Variaci\u00f3n de precipitaci\u00f3n (lluvia y nieve) en el periodo de 1980-2010 ey proyectada al 2035-2065,en el periodo estival e(Dic-Ene-Feb)", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_degradacionturberas_areaturberas", "name": "\u00c1rea de turberas", "description": "Representa el riesgo de degradaci\u00f3n de humedales expresada como la superficie de turberas por comuna", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_degradacionturberas_comuna", "name": "Comuna", "description": "nombre de la Comuna", "units": null, "isnumeric": false}, {"code": "parcc_magallanes_biodiversidadturismo_degradacionturberas_exp_turberas", "name": "\u00cdndicador de exposici\u00f3n", "description": "Estandarizaci\u00f3n del indicador de \u00e1rea de turberas por comuna", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_degradacionturberas_riesgo_turberas", "name": "\u00cdndice de riesgo", "description": "\u00cdndice de riesgo calculado como Amenza x Exposici\u00f3n x Sensibilidad y estandarizado", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_degradacionturberas_sens_turberas", "name": "Indicador de sensibilidad", "description": "\u00cdndice de sensibilidad obtenido a partir del indicadore de turberas no protegidas y estandarizado", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_degradacionturberas_sens_turberasnoprotegidas", "name": "% Superficie de turbas por comuna fuera de SNASPE", "description": "Eval\u00faa la sensibilidad de las turberas al no estar acogidas dentro de una figura de protecci\u00f3n, en este caso, el Sistema Nacional de \u00c1reas Silvestres del Estado", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_fiordos_amen_fiordos", "name": "Amenaza clim\u00e1tica", "description": "\u00cdndice estandarizado de amenaza clim\u00e1tica", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_fiordos_amen_precmaxdiaria", "name": "Variaci\u00f3n de la precipitaci\u00f3n m\u00e1xima diaria", "description": "Mide la variaci\u00f3n de precipitaci\u00f3n m\u00e1xima diaria en el periodo de 1980-2010 en mil\u00edmetros (mm) y proyectada al 2035-2065 en mil\u00edmetros (mm)", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_fiordos_amen_temperaturamedia", "name": "Variaci\u00f3n de la temperatura media", "description": "Cambio proyectado en la temperatura del aire para el periodo de 2035-2065, respecto al periodo base de 1980 -2010", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_fiordos_comuna", "name": "Comuna", "description": "nombre de la Comuna", "units": null, "isnumeric": false}, {"code": "parcc_magallanes_biodiversidadturismo_fiordos_exp_fiordos", "name": "\u00cdndice de exposici\u00f3n", "description": "Estandarizaci\u00f3n del indicador de observaciones de la especie", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_fiordos_riesgo_fiordos", "name": "\u00cdndice de riesgo", "description": "\u00cdndice de riesgo calculado como Amenza x Exposici\u00f3n x Sensibilidad y estandarizado", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_fiordos_sens_densidadpoblacion", "name": "Densidad poblacional", "description": "Indicador de presi\u00f3nque implica mayores actividades antropog\u00e9nicas con una mayor presi\u00f3n sobre el ecosistema.", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_fiordos_sens_fiordos", "name": "Indicador de sensibilidad", "description": "Promedio del indicador de la tasa de retroceso glaciar y la densidad poblacional, estandarizado por m\u00e1ximos absolutos.", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_fiordos_sens_tasaretrocesoglaciar", "name": "Tasa de retroceso glaciar", "description": "Mide el porcentaje de disminuci\u00f3n de los glaciares presentes en la regi\u00f3n mediante la diferencia del \u00e1rea glaciar reportada en los a\u00f1os 2014 a 2022.", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_fiordos_superficie", "name": "Superficie del fiordo (has)", "description": "Indica la cantidad superficie que comprenden los fiordos presentes en la regi\u00f3n. Se estandariza por m\u00e1ximos absolutos.", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_fiordos_zona", "name": "Zona de fiordos", "description": "Zona de fiordos", "units": null, "isnumeric": false}, {"code": "parcc_magallanes_biodiversidadturismo_humedales_adap_protegidos", "name": "Figura de protecci\u00f3n humedales", "description": "Se identifican cuales de los humedales presentan una figura de protecci\u00f3n de Declaraci\u00f3n de humedales urbanos, Humedales RAMSAR", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_humedales_amen_precipacumulada", "name": "Variaci\u00f3n de la precipitaci\u00f3n aumulada", "description": "Variaci\u00f3n de precipitaci\u00f3n (lluvia y nieve) en el periodo de 1980-2010 ey proyectada al 2035-2065,en el periodo estival e(Dic-Ene-Feb)", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_humedales_areahumedales", "name": "\u00c1rea de humedales", "description": "Representa el riesgo de degradaci\u00f3n de humedales expresada como la superficie de humedales por comuna.", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_humedales_comuna", "name": "Comuna", "description": "nombre de la Comuna", "units": null, "isnumeric": false}, {"code": "parcc_magallanes_biodiversidadturismo_humedales_exp_humedal", "name": "\u00cdndicador de exposici\u00f3n", "description": "Estandarizaci\u00f3n del indicador de superficie de humedales por comuna", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_humedales_riesgo_humedal", "name": "\u00cdndice de riesgo", "description": "\u00cdndice de riesgo calculado como Amenza x Exposici\u00f3n x Vulenarabilidad y estandarizado", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_humedales_sens_humedal", "name": "Indicador de sensibilidad", "description": "\u00cdndice de sensibilidad obtenido a partir de los indicadores de sensibilidad", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_humedales_sens_tipohumedal", "name": "Tipo de humedales", "description": "Eval\u00faa la sensibilidad por el tipo de humedal ante la reducci\u00f3n de precipitaciones que depende de la caracter\u00edstica propia de estos", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_humedales_sens_ubicacionhumedal", "name": "Ubicaci\u00f3n del humedal", "description": "Eval\u00faa la probabilidad de la fragmentaci\u00f3n del humedal y de otros impactos antropog\u00e9nicos, tal como su contaminaci\u00f3n, siendo representada como la cercan\u00eda a la poblaci\u00f3n urbana o rural", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_humedales_vuln_humedal", "name": "\u00cdndice de vulnerabilidad", "description": "\u00edndice calculado como \ud835\udc46\u2212\ud835\udc58\u2217(\ud835\udc36\ud835\udc34) y estadarizado por el m\u00e9todo de m\u00e1ximos absolutos", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_nothofagus_amen_precipmax", "name": "Variaci\u00f3n de la precipitaci\u00f3n aumulada", "description": "Variaci\u00f3n de precipitaci\u00f3n (lluvia y nieve) en el periodo de 1980-2010 ey proyectada al 2035-2065,en el periodo estival e(Dic-Ene-Feb)", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_nothofagus_comuna", "name": "Comuna", "description": "nombre de la Comuna", "units": null, "isnumeric": false}, {"code": "parcc_magallanes_biodiversidadturismo_nothofagus_exp_nothofagus", "name": "\u00cdndicador de exposici\u00f3n", "description": "Estandarizaci\u00f3n por logaritmo neperiano del indicador de superficie de bosque nativo por comuna", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_nothofagus_riesgo_nothofagus", "name": "\u00cdndice de riesgo", "description": "\u00cdndice de riesgo calculado como Amenza x Exposici\u00f3n x Sensibilidad y estandarizado", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_nothofagus_sens_castor", "name": "Superficie degradada por presencia del castor", "description": "Indica las hect\u00e1reas de bosque Nothofagus degradadas por el castor y estandarizado por logaritmo neperiano", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_nothofagus_sens_densidadpoblacion", "name": "Densidad poblacional (hab/km2)", "description": "Indica la cantidad de habitantes por cada km2 de la comuna y estandarizado por el m\u00e9todo de m\u00e1ximos absolutos", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_nothofagus_sens_nothofagus", "name": "Indicador de sensibilidad", "description": "Promedio de los dos indicadores de sensibilidad", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_nothofagus_superficiebosque", "name": "Superficie de bosque nativo por comuna", "description": "Indica las hect\u00e1reas de bosque Nothofagus presentes en cada comuna", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_poblacionespinguino_adap_AMP", "name": "Existencia de AMP", "description": "Indica la existencia de \u00e1reas marinas protegidas en cada uno de los puntos de observaci\u00f3n de las especies de inter\u00e9s", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_poblacionespinguino_adap_pinguinos", "name": "\u00cdndice de capacidad adaptativa", "description": "Se asigna factor k de 0,2 porque responde a la eficacia de las figuras de protecci\u00f3n sobre la conservaci\u00f3n de los h\u00e1bitats de especies marinas como los pinguinos, mitigando perturbaciones de origen antr\u00f3pico que puedan generar degradaci\u00f3n de los ecosistemas.", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_poblacionespinguino_amen_temperaturamar", "name": "Variaci\u00f3n de la temperatura superficial del mar (TSM)", "description": "Indica el cambio de temperatura proyectada  para el periodo 2040 - 2050, a partir de registros de la temperatura superficial del mar promedio multianual para el periodo hist\u00f3rico 2002- 2009 y estandarizado por m\u00e1ximos absolutos", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_poblacionespinguino_comuna", "name": "Comuna", "description": "nombre de la Comuna", "units": null, "isnumeric": false}, {"code": "parcc_magallanes_biodiversidadturismo_poblacionespinguino_exp_pinguinos", "name": "\u00cdndice de exposici\u00f3n", "description": "Estandarizaci\u00f3n del indicador de observaciones de la especie", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_poblacionespinguino_observaciones", "name": "Observaciones de la especie", "description": "Indica la cantidad de observaciones en terreno georreferenciados para las especies en las diferentes comunas de la regi\u00f3n. . Estandarizado por logaritmo neperiano.", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_poblacionespinguino_riesgo_pinguinos", "name": "\u00cdndice de riesgo", "description": "\u00cdndice de riesgo calculado como Amenza x Exposici\u00f3n x Vulnerabilidad y estandarizado", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_poblacionespinguino_sens_densidadpoblacion", "name": "Densidad poblacional", "description": "Indicador de presi\u00f3n, se estima que aquellas comunas de mayor densidad poblacional implicar\u00e1n mayores actividades antropog\u00e9nicas. Estandarizado por m\u00e1ximos absolutos", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_poblacionespinguino_sens_pinguinos", "name": "Indicador de sensibilidad", "description": "Estandarizaci\u00f3n del indicador densidad poblacional", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_poblacionespinguino_vuln_pinguinos", "name": "\u00cdndice de vulnerabilidad", "description": "\u00edndice calculado como \ud835\udc46\u2212\ud835\udc58\u2217(\ud835\udc36\ud835\udc34) y estadarizado por el m\u00e9todo de m\u00e1ximos absolutos", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismonaturaleza_adap_pladetur", "name": "Existencia de planes/estrategias de desarrollo de turismo comunales", "description": "Expresa la existencia de planes o estrategias de turismo adoptados en las comunas de la regi\u00f3n", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismonaturaleza_amen_clim", "name": "\u00cdndice de amenaza clim\u00e1tica", "description": "Promedio entre amenazas de precipitaci\u00f3n y viento estandarizados por el m\u00e9todo del m\u00e1ximo absoluto", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismonaturaleza_amen_precipmax", "name": "Variaci\u00f3n de la precipitaci\u00f3n m\u00e1xima diaria", "description": "Variaci\u00f3n de precipitaci\u00f3n m\u00e1xima diaria en el periodo de 1980-2010 ey proyectada al 2035-2065 en mil\u00edmetros (mm)", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismonaturaleza_amen_vientomedio", "name": "Variaci\u00f3n del viento medio", "description": "Variaci\u00f3n del viento medio en el periodo de 1980-2010 y proyectada al 2035-2065 en m/sg", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismonaturaleza_areassilvestres", "name": "N\u00famero de \u00c1reas Silvestres Protegidas", "description": "Indica la cantidad de \u00c1reas Silvestres Protegidas del Estado declaradas presentes en cada comuna estandarizado por m\u00e1ximos absolutos", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismonaturaleza_centrosturisticosnaturaleza", "name": "Centros tur\u00edsticos de naturaleza", "description": "Indica la cantidad de atractivos tur\u00edsticos de naturaleza por comuna que podr\u00edan verse afectados por cierres como resultados de la intensificaci\u00f3n de ventos extremos", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismonaturaleza_comuna", "name": "Comuna", "description": "nombre de la Comuna", "units": null, "isnumeric": false}, {"code": "parcc_magallanes_biodiversidadturismo_turismonaturaleza_exp_turismonaturaleza", "name": "\u00cdndicador de exposici\u00f3n", "description": "Promedio de los tres indicadores de exposici\u00f3n y estandarizado por el m\u00e9todo del m\u00e1ximo absoluto", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismonaturaleza_poblacionflotante", "name": "Poblaci\u00f3n flotante por comuna", "description": "Indica la cantidad de turistas que podr\u00edan verse afectados por la intensificaci\u00f3n de eventos extremos en la regi\u00f3n estandarizado por logaritmo neperiano", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismonaturaleza_riesgo_turismonaturaleza", "name": "\u00cdndice de riesgo", "description": "\u00cdndice de riesgo calculado como Amenza x Exposici\u00f3n x Vulnerabilidad y estandarizado", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismonaturaleza_sens_ofertatur", "name": "Diversidad de oferta tur\u00edstica", "description": "Diversificaci\u00f3n del sector, estimada en base a la presencia comunal de atractivos tur\u00edsticos distintos a los relacionados con glaciares, como aproximaci\u00f3n a la identificaci\u00f3n de la diversidad de la oferta y dependencia respecto de dicha categor\u00eda de atractivo, estandarizado por el m\u00ednimo absoluto", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismonaturaleza_sens_turismonaturaleza", "name": "Indicador de sensibilidad", "description": "Estandarizaci\u00f3n del indicador de diversidad de oferta tur\u00edstica por el m\u00e9todo del m\u00ednimo absoluto", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismonaturaleza_vuln_turismonaturaleza", "name": "\u00cdndice de vulnerabilidad", "description": "\u00edndice calculado como \ud835\udc46\u2212\ud835\udc58\u2217(\ud835\udc36\ud835\udc34) y estadarizado por el m\u00e9todo de m\u00e1ximos absolutos", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismoretroglaciar_adap_pladetur", "name": "Existencia de planes/estrategias de desarrollo de turismo comunales", "description": "Expresa la existencia de planes o estrategias de turismo adoptados en las comunas de la regi\u00f3n", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismoretroglaciar_amen_dismnieveacum", "name": "Porcentaje de disminuci\u00f3n de la nieve acumulada por comuna", "description": "Variaci\u00f3n de la nieve acumulada en el periodo de 1980-2010 y proyectada al 2035-2065 (%) y estandarizada por m\u00e1ximos absolutos", "units": "Porcentaje", "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismoretroglaciar_areaglaciar", "name": "\u00c1rea glaciar", "description": "Expresa la superficie glaciar registrada por comuna estandarizado por logaritmo neperiano", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismoretroglaciar_centrosturisticos", "name": "Centros tur\u00edsticos con superficie glaciar por comuna", "description": "Indica la cantidad de centros tur\u00edsticos por comuna que cuentan con superficie glaciar dentro de su \u00e1rea estandarizado por m\u00e1ximos absolutos", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismoretroglaciar_comuna", "name": "Comuna", "description": "nombre de la Comuna", "units": null, "isnumeric": false}, {"code": "parcc_magallanes_biodiversidadturismo_turismoretroglaciar_exp_turismoglaciar", "name": "\u00cdndice de exposicion calculado como promedio del \u00e1rea glaciar, poblaci\u00f3n flotante y centros tur\u00edsticos", "description": "Promedio de los tres indicadores de exposici\u00f3n y estandarizado por el m\u00e9todo del m\u00e1ximo absoluto", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismoretroglaciar_poblacionflotante", "name": "Poblaci\u00f3n flotante por comuna", "description": "Indica la cantidad de turistas que podr\u00edan verse afectados por la afectaci\u00f3n de atractivos tur\u00edsticos de tipo glaciar en la regi\u00f3n estandarizado por logaritmo neperiano", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismoretroglaciar_riesgo_turismoglaciar", "name": "\u00cdndice de riesgo", "description": "\u00cdndice de riesgo calculado como Amenza x Exposici\u00f3n x Vulnerabilidad y estandarizado", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismoretroglaciar_sens_fuerzatrabajo", "name": "Fuerza de trabajo de sector Turismo por Comuna", "description": "Dependencia del empleo comunal con la industria del turismo considerando el n\u00famero de trabajadores dependientes informados, seg\u00fan comuna y actividades (ACT) y estandarizado por logaritmo neperiano", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismoretroglaciar_sens_ofertatur", "name": "Diversidad de oferta tur\u00edstica", "description": "Diversificaci\u00f3n del sector, estimada en base a la presencia comunal de atractivos tur\u00edsticos distintos a los relacionados con glaciares, como aproximaci\u00f3n a la identificaci\u00f3n de la diversidad de la oferta y dependencia respecto de dicha categor\u00eda de atractivo", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismoretroglaciar_sens_retroglaciar", "name": "Tasa de retroceso glaciar", "description": "Porcentaje de disminuci\u00f3n de  glaciares mediante la diferencia del \u00e1rea glaciar reportada en los a\u00f1os 2014 a 2022", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismoretroglaciar_sens_turismoglaciar", "name": "\u00cdndice de sensibilidad", "description": "Promedio de los tres indicadores de sensibilidad y estandarizado por el m\u00e9todo del m\u00e1ximo absoluto", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_biodiversidadturismo_turismoretroglaciar_vuln_turismoglaciar", "name": "\u00cdndice de vulnerabilidad", "description": "\u00edndice calculado como \ud835\udc46\u2212\ud835\udc58\u2217(\ud835\udc36\ud835\udc34) y estadarizado por el m\u00e9todo de m\u00e1ximos absolutos", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_silvoagropecuario_ovino_adap_pecuario", "name": "\u00cdndice de capacidad adaptativa", "description": "El factor k asignado es de 0,2 porque responde a la eficacia de los programas de asistencia t\u00e9cnica para mejorar la gesti\u00f3n del recurso h\u00eddrico en los predios agr\u00edcolas, sin embargo, ante escenarios de escasez h\u00eddrica por cambio clim\u00e1tico no garantizar\u00eda la disponibilidad del recurso", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_silvoagropecuario_ovino_adapt_beneficiariosindap", "name": "Beneficiarios de programas de asistencia t\u00e9cnica INDAP", "description": "N\u00famero de beneficiarios por comuna del programa \u201cAsistencia t\u00e9cnica especializada y gestor comercial\u201d del INDAP estandarizado por logaritmo neperiano", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_silvoagropecuario_ovino_amen_sequia", "name": "\u00cdndice de amenaza", "description": "Promedio indicadores de sequia y temeperatura y estandarizaci\u00f3n por m\u00e1ximo absoluto", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_silvoagropecuario_ovino_cabezasovino", "name": "N\u00famero de cabezas de ovino", "description": "N\u00famero de ganado ovino, expresado en el n\u00famero total de cabezas censadas por comuna", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_silvoagropecuario_ovino_comuna", "name": "Comuna", "description": "nombre de la Comuna", "units": null, "isnumeric": false}, {"code": "parcc_magallanes_silvoagropecuario_ovino_exp_ovino", "name": "Carga animal ovina", "description": "Estandarizaci\u00f3n del indicador de carga animal ovina", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_silvoagropecuario_ovino_presionovino", "name": "Cabeza ovino por hect\u00e1rea", "description": "Superficie disponible de praderas por ovino, para cada comuna estandarizado por m\u00e1ximo absoluto", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_silvoagropecuario_ovino_probsequia", "name": "Cambio probabilidad de sequias", "description": "Frecuencia de periodos en que la precipitaci\u00f3n acumulada es menor al 75% del promedio de precipitaci\u00f3n acumulada en el periodo de referencia (estandarizado por m\u00e1ximo absoluto)", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_silvoagropecuario_ovino_pueblosoriginarios", "name": "Porcentaje de agricultores de pueblos originarios", "description": "Porcentaje de agricultores de pueblos originarios estandarizado por m\u00e1ximo absoluto", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_silvoagropecuario_ovino_riesgo_pecuario", "name": "\u00cdndice de riesgo", "description": "\u00cdndice de riesgo calculado como Amenza x Exposici\u00f3n x Vulnerabilidad y estandarizado", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_silvoagropecuario_ovino_sens_pecuario", "name": "\u00cdndice de sensibilidad", "description": "Promedio de los tres indicadores de sensibilidad estandarizado por el m\u00e9todo del m\u00e1ximo absoluto", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_silvoagropecuario_ovino_temperatura", "name": "Cambio temperatura del aire", "description": "Cambio en la temperatura del aire estandarizado por m\u00e1ximo absoluto", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_silvoagropecuario_ovino_upas", "name": "Porcentaje de UPAS peque\u00f1as y medianas", "description": "Proporci\u00f3n de unidades de producci\u00f3n agropecuarias peque\u00f1as y medianas estandarizado por m\u00e1ximo absoluto", "units": null, "isnumeric": true}, {"code": "parcc_magallanes_silvoagropecuario_ovino_vuln_pecuario", "name": "\u00cdndice de vulnerabilidad", "description": "\u00edndice calculado como \ud835\udc46\u2212\ud835\udc58\u2217(\ud835\udc36\ud835\udc34) y estadarizado por el m\u00e9todo de m\u00e1ximos absolutos", "units": null, "isnumeric": true}, {"code": "ProvCod", "name": null, "description": null, "units": null, "isnumeric": true}, {"code": "RegCod", "name": null, "description": null, "units": null, "isnumeric": true}, {"code": "SHAPE_Area", "name": null, "description": null, "units": null, "isnumeric": true}, {"code": "SHAPE_Leng", "name": null, "description": null, "units": null, "