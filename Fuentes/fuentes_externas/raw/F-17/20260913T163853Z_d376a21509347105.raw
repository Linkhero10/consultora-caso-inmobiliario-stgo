</script>		<meta http-equiv="Content-Type" content="text/html; charset=ISO-8859-1" />
		<title>Sistema Nacional de Información Municipal</title>

		<link type="text/css" href="assets/css/style.css" rel="stylesheet" media="screen, projection" />
		<link type="application/rss+xml" href="http://www.gob.cl/feed/" rel="alternate" title="RSS 2.0" />
		<link href="assets/css/featured-list.css" rel="stylesheet" type="text/css" />
		<link type="text/css" rel="stylesheet" href="/assets/css/chosen.css"/>
		<link rel="stylesheet" href="assets/js/fancybox/source/jquery.fancybox.css" type="text/css" media="screen" />

		<script type="text/javascript" src="/assets/js/jquery-1.6.4.min.js"></script>
		<!--<script type="text/javascript" src="assets/js/jquery-1.4.2.min.js"></script>-->
		<script type="text/javascript" src="assets/js/base.js"></script>
		<script type="text/javascript" src="assets/js/jquery.colorbox-min.js"></script>
		<script type="text/javascript" src="assets/js/jquery.featureList-1.0.js"></script>
		<script type="text/javascript" src="assets/js/jquery-latest.js" ></script>
		<script type="text/javascript" src="assets/js/jquery.bxSlider.min.js" ></script>
		<!-- <script type="text/javascript" src="assets/js/jquery.pin.js" ></script> -->
		<script type="text/javascript" src="assets/js/jquery.sticky.js" ></script>
		<!-- Sticky Element -->
		<!--script type="text/javascript" src="assets/js/jquery.sticky.js" ></script-->
		<script type="text/javascript" src="/assets/js/chosen.jquery.js"></script>
		<script type="text/javascript" src="assets/js/fancybox/source/jquery.fancybox.pack.js"></script>
		<script type="text/javascript" src="/assets/js/jquery.printPage.js"></script>

		<script type="text/javascript">
			//PAGINACION: Datos para controlar la paginacion
			var cantidadTotalColumnas = 6; //Cantidad de datos a extraer de la base de datos
			var cantidadTotalFilas = 100; //Cantidad de filas a mostrar

			var pagActualDatos = 1;
			var pagActualValores = 1;
			var pagActualPeriodos = 1;
			var bloqueActualMunicipios = 1;

			var graIndicadores = "";
			var graAnios = "";
			var graMunicipios = "";

			var pagTotalDatos = 0;
			var pagTolalValores = 0;
			var pagTotalPeriodos = 0;

			var firstElementHTML = '';

			var ordenCampoMunicipio = "id_legal";
			var ordenTipo = 'ASC';
			var setFactor = false; // Si es necesario realizar el cambio monetario

			var arrPeriodos = [];
			var arrDatos = [];
			var arrColumnas = [];
			var arrColPagina =[];
			var arrMunicipios = [];
			var arrValores = [];
			var arrVariables = [];

			var isLoadMore = 0;
			var argGraficos = '';
			var grafDisable = false;

			var customClassName = 'is-sticky';
			var customWrapperClassName = 'sticky-wrapper';


			$(function(){

				$("#header_resultados").hide();
				$("#resultados").hide();
				$("#bredcrumb_busqueda").hide();
				$("#MensajeCarga").hide();
				$("#MensajeCarga2").hide();

				$.fn.getCallBack = function(callback){
					if(callback !== undefined){
						callback();
					}
				}
				$.fn.toggleSticky = function() {
					if ($("#sticker").hasClass(customClassName)) {
						$("#sticker").sticky('destroy').sticky({ className: customClassName, wrapperClassName: customWrapperClassName });
					} else {
						$("#sticker").sticky({ className: customClassName, wrapperClassName: customWrapperClassName });
					}
				}

				$.fn.reloadIdColumnasValores = function(){
					$.each(arrColumnas, function(i,o){
						if(pagActualDatos == i)
						{
							arrColPagina = o;
							return;
						}
					});
				}

				$.fn.setCambioMonetario = function(){
					// Ok: Setear si se realiza o no la correccion monetaria
					if(setFactor){						 
						$("#descripcion_corr").text("Aplicar factor de actualización monetaria"); 
						setFactor = 0;
					}else{
						$("#descripcion_corr").text("Quitar factor de actualización monetaria");
						setFactor = 1;
					}
				}

				$.fn.getFichaLigthBoxContent = function(){
					$.each($('div.dato a'), function(i, o){
						if($(o).prop('id') != ''){

							$.post("/datos_municipales/obtener_datos.php", { dato: $(o).prop('id') },
							function(data) {
								var id = $(o).prop('id').split('-');
								$('#section_'+id[0]).html(data);
							});
						}

					});
				}

				$.fn.getContenidoValores = function(callback){
										
					$.post("/datos_municipales/obtener_valores.php",{variables: arrVariables, municipios: arrMunicipios.textos, pagina: pagActualDatos, corrmon: setFactor},
						(function(valores) {

						// OK: Obtenemos los datos desde la base de datos y los guardamos dentro de un arreglo para realizar precarga
						var arrValoresPag;
						var contador = 1;
						arrValoresPag = '';
						arrValoresPag = [];

						$.each(valores.textos, function(i,o){
							$('#inner-' + o.col + '-' + o.municipio).html(o.valor);
							arrValoresPag.push({'idElement':'#inner-' + o.col + '-' + o.municipio,'valor':o.valor});
							if(contador == 1){
								firstElementContent = '#inner-' + o.col + '-' + o.municipio;
								contador = 2;
							}

						});
						arrValores[pagActualDatos] = {'contenido':arrValoresPag , 'isFull':true, 'firstElementContent': firstElementContent};
						if(callback !== undefined){
							callback();
						}

					}),"json");
				
				}

				$.fn.getListaMunicipios = function(callback){
					$.post("/datos_municipales/obtener_municipios.php",{region: $('#regiones').val(), municipio: $('#municipios').val(), limit: cantidadTotalFilas, campo: ordenCampoMunicipio, orden: ordenTipo, pagina: 1},
						(function(data) {						
						$('.resultado_municipios').html('');

						var classCol = '';
						var classSpam = '';
						arrMunicipios = '';
						arrMunicipios = data;
						graMunicipios = data.municipios;

						if(data.graf.flag == 0){
							$('#message-graf').html(data.graf.texto);
							$('#graficar_indicador').css('display','none');
							$('#message-graf').addClass('message-text');
							grafDisable = true;
						}else{
							$('#message-graf').html('');
						 	$('#graficar_indicador').css('display','');
							$('#message-graf').removeClass('message-text');
							grafDisable = false;
						}

						if(arrMunicipios.paginas[2] == undefined )
						{
							$('#more-towns-wrap').hide();
						}else{
							$('#more-towns-wrap').show();
						}
						
						$.each(arrMunicipios.textos, function(i,o){

							if(o.tipoCol == 'par'){
								classCol = 'par';
								classSpam = 'cod_mun_impar';
							}else{
								classCol = 'impar';
								classSpam = 'cod_mun_par';
							}
							// OK : Cambio de variable id por idLegal para obtener los codigos Legales
							// OK : Nombres largos tendran fuente mas pequeña
							var nombreMunicipio = o.municipio;
							nombreMunicipio = '<span title="' + nombreMunicipio + '" id="Muni-' + o.idLegal + '"  class="item_large" >' + nombreMunicipio + '</span>';
							var divdato ='<div id="'+o.idLegal+'" class="item_municipio ' + classCol + '""><span class="' + classSpam + '">'+ o.idLegal +'</span> ' + nombreMunicipio + '</div>';
							$('.resultado_municipios').append(divdato);
						});
						if(callback !== undefined){
							callback();
						}
					}), "json");
				}

				$.fn.createHTMLValuesContent = function(){
					//@arrColPagina --> Arreglo con los datos para crear los contenedores personalizados
					$.each(arrColPagina, function(i,o){
						$(".resultado_dato_wrap #valores li").append('<div id="' + o + '" class="resultado_dato"></div>');
						$("#" + o).html('');
						//Recorremos el arreglo de municipios con los datos para crear las celdas
						var contador = 1;
						$.each(arrMunicipios.textos, function(x,value){
							if(value.tipoCol == 'par'){
								classCol = 'par';
							}else{
								classCol = 'impar';
							}
							$("#" + o).append('<div id="inner-' + o + '-' + value.id_municipio + '" class="item_dato ' + classCol + '""></div>');
							if(contador == 1){
								firstElementHTML = '#inner-7-'+ value.id_municipio;
								contador = 2;
							}
						});
					});
				}

				$.fn.clearSearchGrill = function(){
					$("#header_resultados").fadeOut('slow');
					$("#resultados").fadeOut('slow');
					$("#links").fadeIn('slow');
					$("#top").fadeIn('slow');
					$("#bredcrumb_busqueda").fadeOut('slow');
					$(".introduccion").fadeIn('slow');
					$(this).toggleSticky();
				}

				$.fn.OpenSearchGrill = function(){
					$("#header_resultados").fadeIn('slow');
					$("#resultados").fadeIn('slow');
					$("#links").fadeOut('slow');
					$("#top").fadeOut('slow');
					$("#bredcrumb_busqueda").fadeIn('slow');
					$(".introduccion").fadeOut();
					$(this).toggleSticky();
				}

				// OK: Agregar onbtencion de datos segun vaya navegando
				/***** Navegacion de la paginacion *****/
				$('#go-prev').click(function(e){
					e.stopPropagation();

					if(parseInt(pagActualDatos) > 1){
						arrMunicipios.textos = arrMunicipios.paginas[1];
						pagActualDatos--;
						bloqueActualMunicipios = 2;
						var texto = 'Mostrando ' + pagActualDatos + ' de ' + arrDatos.length;

						if(isLoadMore){
							arrValores = [];
							$('.resultado_municipios').getListaMunicipios();
						}


						$('.paginacion p').html(texto);
						$('.slide_datos_wrap ul#datos_cols').html(arrDatos[pagActualDatos - 1]);
						$('.slide_datos_wrap ul#periodos_header').html(arrPeriodos[pagActualDatos - 1]);

						// Se obtienen los datos para asignarle el contenido del fancybox
						$('div.dato').getFichaLigthBoxContent();
						if (arrValores[pagActualDatos]) {
							//Inicializamos el contenedor de datos y variables
							$("#MensajeCarga").show();
							$(".resultado_dato_wrap #valores li").html('').reloadIdColumnasValores()
							$(".resultado_dato_wrap #valores li").createHTMLValuesContent();
							if($(arrValores[pagActualDatos].firstElementContent).length > 0){
								var arrValoresPag = [];
								$.each(arrValores[pagActualDatos].contenido, function(i,o){
									$(o.idElement).html(o.valor);
								});
								
							}else{
								$("#MensajeCarga").show();
								$(".resultado_dato_wrap #valores li").getContenidoValores(function(){
									$("#MensajeCarga").hide();
								});
							}
							

						}else{

							//Inicializamos el contenedor de datos y variables

							$(".resultado_dato_wrap #valores li").html('').reloadIdColumnasValores();
							$(".resultado_dato_wrap #valores li").createHTMLValuesContent();
							$("#MensajeCarga").show();
							$(".resultado_dato_wrap #valores li").getContenidoValores(function(){
									$("#MensajeCarga").hide();
								});
						}
						$("#MensajeCarga").hide();
					}

					return false;
				});

   
				$('#go-next').click(function(e){
					e.stopPropagation();

					if(parseInt(pagActualDatos) < arrDatos.length){
						arrMunicipios.textos = arrMunicipios.paginas[1];
						pagActualDatos++;
						bloqueActualMunicipios = 2;
						var texto = 'Mostrando ' + pagActualDatos + ' de ' + arrDatos.length;
						
						if(isLoadMore == 1){
							arrValores = [];
							$('.resultado_municipios').getListaMunicipios(); // Agrega los minucipios
							isLoadMore == 0;
						}

						$('.paginacion p').html(texto); //Texto con los datos de la paginacion. Indicando pagina actual y el total de estas
						$('.slide_datos_wrap ul#datos_cols').html(arrDatos[pagActualDatos - 1]); // Agregamos los datos de cabecera (Titulos)
						$('.slide_datos_wrap ul#periodos_header').html(arrPeriodos[pagActualDatos - 1]); // Agregamos los datos de cabecera (Fechas)

						// Se obtienen los datos para asignarle el contenido del fancybox
						$('div.dato').getFichaLigthBoxContent();
						
						if (arrValores[pagActualDatos]) {
							//Inicializamos el contenedor de datos y variables
							$("#MensajeCarga").show();
							$(".resultado_dato_wrap #valores li").html('').reloadIdColumnasValores();
							$(".resultado_dato_wrap #valores li").createHTMLValuesContent();
							if($(arrValores[pagActualDatos].firstElementContent).length > 0){
								var arrValoresPag = [];
								
								$.each(arrValores[pagActualDatos].contenido, function(i,o){
									$(o.idElement).html(o.valor);
								});
									
							}else{
								$("#MensajeCarga").show();
								$(".resultado_dato_wrap #valores li").getContenidoValores(function(){
									$("#MensajeCarga").hide();
								});
							}
							
						}else{
							
							//Inicializamos el contenedor de datos y variables
							$(".resultado_dato_wrap #valores li").html('').reloadIdColumnasValores();
							$(".resultado_dato_wrap #valores li").createHTMLValuesContent();
							$("#MensajeCarga").show();
							$(".resultado_dato_wrap #valores li").getContenidoValores(function(){
									$("#MensajeCarga").hide();
								});

						}
						
							
					}
				
					return false;
				});
				/***** Fin Navegacion de la paginacion *****/

				//Setear si ajax Funciona asincronicamente o no
				$.ajaxSetup({
					async: true
				});

				// OK : Crear Metodo para validar flujo de selección de filtros
				/*** Validaciones ***/
				var validar =(function(o){

					// OK : validar la clase inicial
					if($(o).attr('class') != 'sel_area') {

						if($("#dato_area").val() == null) {
							alert("Debe seleccionar al menos un Área");
							return false;
						}

						if($("#dato_subarea").val() == null) {
							alert("Debe seleccionar al menos una Sub-Área");
							return false;
						}

						if($(o).attr('class') != 'sel_consulta') {

							if($("#variables").val() == null) {
								alert("Debe seleccionar al menos una Variable o Indicador");
								return false;
							}

							if($(o).attr('class') != 'sel_periodo') {

								if($("#periodos").val() == null) {
									alert("Debe seleccionar al menos un Año");
									return false;
								}

								if($(o).attr('class') != 'sel_region') {

									if($("#regiones").val() == null) {
										alert("Debe seleccionar al menos una Región");
										return false;
									}

									if($(o).attr('class') != 'sel_municipio') {

										if($("#municipios").val() == null) {
											alert("Debe seleccionar al menos un Municipio");
											return false;
										}
									}

								}

							}

						}

					}

					return true;
				});
				/*** Fin Validaciones ***/

				//Dropdown en menú de búsqueda de datos
				/*** Menú de busqueda Dropdown ***/
				$.fn.fixedMenu = function () {
				  return this.each(function () {
					var menu = $(this);

					menu.find('ul li > a').bind('click', function () {
						// Validación de selección de filtros
						if(validar($(this))) {
							//check whether the particular link has a dropdown
							if (!$(this).parent().hasClass('single-link') && !$(this).parent().hasClass('current')) {
								//Esconde el dropdown menú cuando es clickeado nuevamente
								if ($(this).parent().hasClass('active2')) {
									$(this).parent().removeClass('active2');
								} else {
									//Muestra el dropdown menú
									$(this).parent().parent().find('.active2').removeClass('active2');
									$(this).parent().addClass('active2');
								}
							} else {
								//Oculta el dropdown menú cuando otro link es clickeado
								$(this).parent().parent().find('.active2').removeClass('active2');
							}
						}
					});

					$(document).click(function(e){
					  if(e.target !== menu.get(0) && menu.find($(e.target)).length === 0)
						  menu.find('.active2').removeClass('active2');
					});
				  });
				}

				$(".menu_busqueda").fixedMenu();

				// Chosen
				$(".chzn-select").chosen();
				$(".chzn-select-limit").chosen( { max_selected_options: 6 });
				$(".chzn-select-deselect").chosen({allow_single_deselect:true});
				/*** Fin Menú de busqueda Dropdown ***/

				//Dropdown Orden de los municipios
				/*** Orden de municipios (Opciones) ***/
				$("#orden_wrap").click(function(e) {

					var $target = $(e.target);
					var isModalBox = (e.target.className == 'modal-box');

					if (!isModalBox) {
						$('.modal-box:visible').animate({
							"margin-top": "-15px"
						}, 75, function() {
							$(this).fadeOut(75);
						});
					}
				});
				/*** Fin Orden de municipios (Opciones) ***/

				$('#temp-button').click(function(e) {
					e.preventDefault();
					$('.modal-box').toggle().animate({
						"margin-top": "0px"
					}, 75);
				});

				//Fancybox
				$(".fancybox").fancybox();

				// OK : obtener las variables asociadas a las areas seleccionadas
				$("#dato_area").change(function() {
					$('#dato_subarea').find('option:not(:first)').remove().end();
					$('#dato_subarea').trigger("liszt:updated");
					$('#dato_subarea').append($("<option></option>").val('T').text('TODAS LAS SUBÁREAS'));

					var areas = [];
					$('#bredcrumb_busqueda .bcrum_areas').text('');
					$('#bredcrumb_busqueda .bcrum_subarea').text('');
					if($(this).val() != null) {							
						$.post("/datos_municipales/obtener_datos_filtros.php", { dato_area: $(this).val() },
						function(data) {

							$.each(data, function (index) {
								var optgroup = $('<optgroup>');
								optgroup.attr('label', index);

								$.each(data[index], function (i, o) {
									var option = $("<option></option>");
									option.val(o.id_subarea);
									option.text(o.nombre_subarea);

									optgroup.append(option);
								});
								$('#dato_subarea').append(optgroup);
							});

							$('#dato_subarea').trigger("liszt:updated");

						}, "json");

						$('#dato_area option:selected').each(function(index, value) {
							areas.push($(value).text());
						});
						$('#bredcrumb_busqueda .bcrum_areas').append(areas.join(', '));

					}else{
						$(this).clearSearchGrill();
					}
				});

				// OK : obtener las variables asociadas a las areas seleccionadas
				$("#dato_subarea").change(function() {
					$('#variables').find('option:not(:first)').remove().end();
					$('#variables').trigger("liszt:updated");
					$('#variables').append($("<option></option>").val('T').text('TODOS LOS DATOS'));

					var subareas = [];
					$('#bredcrumb_busqueda .bcrum_subarea').text('');
					$('#bredcrumb_busqueda .bcrum_variables').text('');					
					if($(this).val() != null) {							
						$.post("/datos_municipales/obtener_datos_filtros.php", { dato_area: $("#dato_area").val(), dato_subarea: $(this).val() },
						function(data) {

							$.each(data, function (index) {
								var optgroup = $('<optgroup>');
								optgroup.attr('label', index);

								$.each(data[index], function (i, o) {
									var option = $("<option></option>");
									option.val(o.id_dato);
									option.text(o.mtro_datos_codigo + ' - ' +o.mtro_datos_nombre);

									optgroup.append(option);
								});
								$('#variables').append(optgroup);
							});

							$('#variables').trigger("liszt:updated");

						}, "json");
						$('#dato_subarea option:selected').each(function(index, value) {subareas.push($(value).text());});
						$('#bredcrumb_busqueda .bcrum_subarea').append(subareas.join(', '));
					}else{
						$(this).clearSearchGrill();
					}
				});

				$('#variables').change(function(){

					$("#bredcrumb_busqueda .bcrum_variables .itemb").remove();
					$("#bredcrumb_busqueda .bcrum_variables .ico_mas").remove();
					$("#bredcrumb_busqueda .bcrum_variables .space").remove();

					if($(this).val() != null) {

						$('#bredcrumb_busqueda .bcrum_variables span').append('<span class="ico_mas">+</span>');
						$('#variables option:selected').each(function(index, value) {
							var span = $('<span></span>').addClass('preview_dato itemb').text($(value).text());
							$('#bredcrumb_busqueda .bcrum_variables').append(span);
							$('#bredcrumb_busqueda .bcrum_variables').append('<i class="space">&nbsp;</i>');
						});
					}else{
						// $("#header_resultados").fadeOut();
						// $("#resultados").fadeOut();
						$(this).clearSearchGrill();
					}
				});

				$('#periodos').change(function(){

					$("#bredcrumb_busqueda .bcrum_anios .itemb").remove();
					$("#bredcrumb_busqueda .bcrum_anios .ico_mas").remove();
					$("#bredcrumb_busqueda .bcrum_anios .space").remove();

					if($(this).val() != null) {

						$('#bredcrumb_busqueda .bcrum_anios span').append('<span class="ico_mas">+</span>');
						$('#periodos option:selected').each(function(index, value) {
							var span = $('<span></span>').addClass('preview_periodo itemb').text($(value).text());
							$('#bredcrumb_busqueda .bcrum_anios').append(span);
							$('#bredcrumb_busqueda .bcrum_anios').append('<i class="space">&nbsp;</i>');
						});
					}else{
						$(this).clearSearchGrill();
					}
				});

				$('#regiones').change(function(){

					$('#municipios').find('option:not(:first)').remove().end();
					$('#municipios').trigger("liszt:updated");
					$('#municipios').append($("<option></option>").val('T').text('TODOS LOS MUNICIPIOS'));

					$("#bredcrumb_busqueda .bcrum_regiones .itemb").remove();
					$("#bredcrumb_busqueda .bcrum_regiones .ico_mas").remove();
					$("#bredcrumb_busqueda .bcrum_regiones .space").remove();

					$("#bredcrumb_busqueda .bcrum_municipios .itemb").remove();
					$("#bredcrumb_busqueda .bcrum_municipios .ico_mas").remove();
					$("#bredcrumb_busqueda .bcrum_municipios .space").remove();

					if($(this).val() != null) {

						$.post("/datos_municipales/obtener_datos_filtros.php", { region: $(this).val() },
						function(data) {

							$.each(data, function (i, o) {
								var option = $("<option></option>");
								option.val(o.id);
								option.text(o.municipio);

								$('#municipios').append(option);
							});

							$('#municipios').trigger("liszt:updated");

						}, "json");

						$('#bredcrumb_busqueda .bcrum_regiones span').append('<span class="ico_mas">+</span>');
						$('#regiones option:selected').each(function(index, value) {
							var span = $('<span></span>').addClass('preview_region itemb').text($(value).text());
							$('#bredcrumb_busqueda .bcrum_regiones').append(span);
							$('#bredcrumb_busqueda .bcrum_regiones').append('<i class="space">&nbsp;</i>');
						});
					} else {
						$('.resultado_municipios').html('');
						$(this).clearSearchGrill();
					}
				});


				$('#municipios').change(function(){
					$("#bredcrumb_busqueda .bcrum_municipios .itemb").remove();
					$("#bredcrumb_busqueda .bcrum_municipios .ico_mas").remove();
					$("#bredcrumb_busqueda .bcrum_municipios .space").remove();
					if($(this).val() != null) {
						$('#bredcrumb_busqueda .bcrum_municipios span').append('<span class="ico_mas">+</span>');
						$('#municipios option:selected').each(function(index, value) {
							var span = $('<span></span>').addClass('preview_municipio itemb').text($(value).text());
							$('#bredcrumb_busqueda .bcrum_municipios').append(span);
							$('#bredcrumb_busqueda .bcrum_municipios').append('<i class="space">&nbsp;</i>');
						});
					} else {
						$(this).clearSearchGrill();
					}


				});
				$('#ver-resultado').click(function(e){
					e.preventDefault();
					$(".sinfinescomerciales").hide();
//VER
					// OK : Validar los campos
					if($('#dato_area').val() !== null && $('#dato_subarea').val() !== null && $('#variables').val() !== null && $('#periodos').val() !== null && $('#regiones').val() !== null && $('#municipios').val() !== null){
						$("#MensajeCarga2").show(); //Show Mensaje de Carga
						// OK : obtener el listado de municipios
						// OK : Crear Paginador - Con control de paginación
						cantidadTotalColumnas = 6;
						grafDisable = false;
						//setTimeout(function(){$('.resultado_municipios').getListaMunicipios()},1)
						$('.resultado_municipios').getListaMunicipios(function(){						
						// TODO :  Indentificar los años y enviar los textos para eliminar una consulta a BD
						// OK :  gatillar llamada para busqueda de datos
						var argumentos = {area: $('#dato_area').val()
										, subarea: $('#dato_subarea').val()
										, variables: $('#variables').val()
										, periodos: $('#periodos').val()
										, region: $('#regiones').val()
										, municipio: $('#municipios').val() }

						$.post("/datos_municipales/obtener_cabecera.php", argumentos ,
						(function(data) {

							// Inicializar datos
							pagActualDatos = 1;
							pagActualValores = 1;
							pagActualPeriodos = 1;
							bloqueActualMunicipios = 2;

							pagTotalDatos = 0;
							pagTolalValores = 0;
							pagTotalPeriodos = 0;

							arrPeriodos = [];
							arrDatos = [];
							arrValores = [];
							arrColumnas = [];
							arrVariables = [];
							cantColumnas = 0;

							graIndicadores = data.indicadores;
							graAnios = data.anios;


							arrColumnas = data.columnas;
							arrVariables = data.paginas;							
							if(data.exportar.flag == 0){
								$('#message').html(data.exportar.texto);
								$('#planilla_excel').css('display','none');
								if(grafDisable){
									$('.municipio').addClass('margintop93');
									$('.municipio').removeClass('margintop64');
									$('.municipio').removeClass('margintop35');
								}else{
									$('.municipio').addClass('margintop64');
									$('.municipio').removeClass('margintop93');
									$('.municipio').removeClass('margintop35');
									// $('.municipio').removeClass('margintop64'	);
								}
								$('#message').addClass('message-text');
							}else{
								$('#message').html('');
								$('#planilla_excel').css('display','');
								if(grafDisable){
									$('.municipio').addClass('margintop64');
									$('.municipio').removeClass('margintop93');
									$('.municipio').removeClass('margintop35');
								}else{
									$('.municipio').addClass('margintop64');
									$('.municipio').removeClass('margintop93');
									$('.municipio').removeClass('margintop64');
								}
								$('#message').removeClass('message-text');
							}

							$(".resultado_dato_wrap #valores li").html('')
							$('.slide_datos_wrap ul#datos_cols li').remove();
							$('.slide_datos_wrap ul#periodos_header li').remove();

							var divtextos = $('<div></div>').addClass('dato_wrap');
							var divperiodos = $('<div></div>').addClass('periodo_wrap');

							// Se recorren los datos
							var cerrar = true;
							var cantidadTitulos = 6;

							$.each(data.textos, function(i, o){
								var divdato = $('<div></div>').addClass('dato');
								var dato = o.id_dato + '-' + o.id_subarea;
								var adato = $('<a></a>').prop('href', '#dato_'+o.id_dato).prop('id', dato).addClass('fancybox');
								var sdato = $('<section></section>').prop('id', 'section_'+o.id_dato);

								if((i%6) == 0) {
									cerrar = true;
									divtextos.empty();
								}

								if((i%6) <= 5) {
									cantidadTitulos--;
									adato.html(o.mtro_datos_nombre + '<br><span class="mtro_datos_codigo"><strong>(' + o.unidad_medida_simbolo + ')<br>' + o.mtro_datos_codigo + '</strong></span>');
									divdato.append(adato);
									divdato.append(sdato);
									divtextos.append(divdato);
								}

								if((i%6) == 5) {
									cerrar = false;
									arrDatos.push($('<li>').append(divtextos.html()));
									cantidadTitulos = 6
								}
								cantColumnas++;
							});
							if(cerrar){
								//arrDatos.push($('<li>').append(divtextos.html()));
								if(cantidadTitulos > 0){
									for (var i = 1; i <= cantidadTitulos; i++) {
										var divdato = $('<div></div>').addClass('dato');
										//var dato = o.id_dato + '-' + o.id_subarea;
										var adato = $('<a></a>');
										var sdato = $('<section></section>').prop('id', 'section_Sin_valor');
										adato.text('');
										divdato.addClass('sn-data');
										divdato.append(adato);
										divdato.append(sdato);
										divtextos.append(divdato);
									};
								}
								arrDatos.push($('<li>').append(divtextos.html()));
							}
							$('.slide_datos_wrap ul#datos_cols').append(arrDatos[0]);


							// Se recorren los periodos
							var cerrar = true
							var cantidadTitulos = 6;

							$.each(data.periodos, function(i, o){


								var divperiodo = $('<div></div>').addClass('periodo');

								if((i%6) == 0) {
									cerrar = true;
									divperiodos.empty();
								}

								if((i%6) <= 5) {
									cantidadTitulos--;
									divperiodo.append(o.anio);
									divperiodos.append(divperiodo);
								}

								if((i%6) == 5) {
									arrPeriodos.push($('<li>').append(divperiodos.html()));
									cerrar = false;
								}

							});
							if(cerrar){
								if(cantidadTitulos > 0){
									for (var i = 1; i <= cantidadTitulos; i++) {
										var divperiodo = $('<div></div>').addClass('periodo');
										divperiodo.addClass('sn-data');
										divperiodo.append('&nbsp;');
										divperiodos.append(divperiodo);
									};
								}
								arrPeriodos.push($('<li>').append(divperiodos.html()));
							}
							$('.slide_datos_wrap ul#periodos_header').append(arrPeriodos[0]);

							// Se obtienen los datos para asignarle el contenido del fancybox
							$('div.dato').getFichaLigthBoxContent();

							//OK: Mostramos el total de paginas de la cabecera y guardamos en una variable global
							$('.paginacion p').html('Mostrando 1 de ' + arrDatos.length);
							pagTotalDatos = arrDatos.length;
							pagTotalPeriodos = arrPeriodos.length;

							//Inicializamos el contenedor de datos y variables
							$(".resultado_dato_wrap #valores li").html('').reloadIdColumnasValores();
							$(".resultado_dato_wrap #valores li").createHTMLValuesContent()
							$(this).toggleSticky();
							$("#MensajeCarga").show();
							$(".resultado_dato_wrap #valores li").getContenidoValores(function(){
								$("#MensajeCarga").hide();
								$(".introduccion").fadeOut();
								$("#header_resultados").fadeIn('slow');
								$("#resultados").fadeIn('slow');
								$("#links").fadeOut('slow');
								$("#top").fadeOut('slow');
								// $("#bredcrumb_busqueda").fadeIn('slow');
								$(this).toggleSticky();
							});
							$("#MensajeCarga2").hide(); //Hide Mensaje de Carga
						}), "json");});
						

					}else{
						$(".sinfinescomerciales").show();
						$(this).clearSearchGrill();
						alert('Complete el filtro para realizar la busqueda');
					}

				});
				/*** Modal Box ***/

				$('#modal-box-1 #opcion1').click(function(e) {
					e.preventDefault();
					bloqueActualMunicipios = 1;
					if (ordenTipo == 'DESC')
						ordenTipo = 'ASC';
					else
						ordenTipo = 'DESC';

					if(ordenCampoMunicipio == 'municipio')
					{
						ordenCampoMunicipio = "id_legal";
						ordenTipo = 'ASC';
					}

					arrValores = [];
					$('.resultado_municipios').getListaMunicipios(function(){
						$(".resultado_dato_wrap #valores li").html('').reloadIdColumnasValores();
						$(".resultado_dato_wrap #valores li").createHTMLValuesContent();
						$(".resultado_dato_wrap #valores li").getContenidoValores();
					});
					bloqueActualMunicipios = 2;
					$('.modal-box').toggle().animate({
						"margin-top": "0px"
					}, 75);
				});

				$('#modal-box-1 #opcion2').click(function(e) {
					e.preventDefault();
					bloqueActualMunicipios = 1;
					if (ordenTipo == 'DESC')
						ordenTipo = 'ASC';
					else
						ordenTipo = 'DESC';

					if(ordenCampoMunicipio == 'id_legal')
					{
						ordenCampoMunicipio = "municipio";
						ordenTipo = 'ASC';
					}
					arrValores = [];
					$('.resultado_municipios').getListaMunicipios(function(){
						$(".resultado_dato_wrap #valores li").html('').reloadIdColumnasValores();
						$(".resultado_dato_wrap #valores li").createHTMLValuesContent();
						$(".resultado_dato_wrap #valores li").getContenidoValores();
					});
					bloqueActualMunicipios = 2;
					$('.modal-box').toggle().animate({
						"margin-top": "0px"
					}, 75);
				});

				/*** Fin Modal Box ***/

				/*** Funciones Excel y Corrector Monetario ***/
				$('#Corrector_monetario').click(function(e){
					e.preventDefault();
					$(this).setCambioMonetario();
					arrValores = [];
					$(".resultado_dato_wrap #valores li").html('').reloadIdColumnasValores();
					$(".resultado_dato_wrap #valores li").createHTMLValuesContent();
					$(".resultado_dato_wrap #valores li").getContenidoValores();
				});

				$("#planilla_excel").click(function(e){
					e.preventDefault();
					var getvar ="area[]="+$('#dato_area').val();
					getvar +="&subarea[]="+$('#dato_subarea').val();
					getvar +="&variables[]="+$("#variables").val();
					getvar +="&periodos[]="+$('#periodos').val();
					getvar +="&regiones[]="+$('#regiones').val();
					getvar +="&municipios[]="+$('#municipios').val();
					getvar +="&corrmon="+setFactor;
					window.open("/datos_municipales/obtener_datos_municipales.php?"+getvar,'_blank');
				});

				$('#graficar_indicador').click(function(e){
					e.preventDefault();
					window.open("/datos_municipales/graficar_indicador.php?indicadores="+graIndicadores+"&anios="+graAnios+"&municipios="+graMunicipios+"&correccion="+setFactor,'_blank');
				});
				

				/*** Funciones Excel y Corrector Monetario ***/

				/*** Funcion para obtener los siguientes registros***/

				$('a#next').click(function(e){
					e.preventDefault();
					if(arrMunicipios.paginas[bloqueActualMunicipios] != undefined )
					{
						isLoadMore = 1;
						arrNextMunicipio = arrMunicipios.paginas[bloqueActualMunicipios];
						bloqueActualMunicipios++;
						$.each(arrNextMunicipio, function(i,o){
							if(o.tipoCol == 'par'){
								classCol = 'par';
								classSpam = 'cod_mun_impar';
							}else{
								classCol = 'impar';
								classSpam = 'cod_mun_par';
							}
							// OK : Cambio de variable id por idLegal para obtener los codigos Legales
							// OK : Nombres largos tendran fuente mas pequeña
							var nombreMunicipio = o.municipio;
							// if(nombreMunicipio.length > 14){
							nombreMunicipio = '<span title="' + nombreMunicipio + '" id="Muni-' + o.idLegal + '" class="item_large" >' + nombreMunicipio + '</span>';
							// }
							var divdato ='<div id="'+o.idLegal+'" class="item_municipio ' + classCol + '""><span class="' + classSpam + '">'+ o.idLegal +'</span> ' + nombreMunicipio + '</div>';
							$('.resultado_municipios').append(divdato);
							arrMunicipios.textos.push(o);
						});

						arrValores = [];
							$("#MensajeCarga").show();
						$.each(arrColPagina, function(i,o){
							var contador = 1;
							$.each(arrNextMunicipio, function(x,value){
								if(value.tipoCol == 'par'){
									classCol = 'par';
								}else{
									classCol = 'impar';
								}
								$("#" + o).append('<div id="inner-' + o + '-' + value.id_municipio + '" class="item_dato ' + classCol + '"></div>');
								if(contador == 1){
									firstElementHTML = '#inner-7-'+ value.id_municipio;
									contador = 2;
								}
							});
						});
						
						$.post("/datos_municipales/obtener_valores.php",{variables: arrVariables, municipios: arrMunicipios.textos, pagina: pagActualDatos, corrmon: setFactor},
						(function(valores) {
							// OK: Obtenemos los datos desde la base de datos y los guardamos dentro de un arreglo para realizar precarga
							var arrValoresPag;
							var contador = 1;
							arrValoresPag = [];
							$.each(valores.textos, function(i,o){
								$('#inner-' + o.col + '-' + o.municipio).html(o.valor);
								arrValoresPag.push({'idElement':'#inner-' + o.col + '-' + o.municipio,'valor':o.valor});
								if(contador == 1){
									firstElementContent = '#inner-' + o.col + '-' + o.municipio;
									contador = 2;
								}
							});
							$("#MensajeCarga").hide();
						}),"json");
						

						if(arrMunicipios.paginas[bloqueActualMunicipios] == undefined )
						{
							$('#more-towns-wrap').hide();
						}else{
							$('#more-towns-wrap').show();
						}

					}

				});

			});
		</script>

